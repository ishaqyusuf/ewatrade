model Site {
  id                String             @id @default(cuid())
  tenantId          String
  storeId           String
  slug              String
  name              String
  status            SiteStatus         @default(DRAFT)
  domain            String?
  isPrimary         Boolean            @default(false)
  seoTitle          String?
  seoDescription    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  managedDomains    ManagedDomain[]
  domainConnections DomainConnection[]
  /// The single editable draft; every write must match draftRevision (CAS).
  draftComposition  Json?
  draftRevision     Int                @default(0)
  draftUpdatedById  String?
  draftUpdatedAt    DateTime?
  /// Authoritative live pointer; public reads use only this release.
  activeReleaseId   String?            @unique
  activeRelease     SiteRelease?       @relation("SiteActiveRelease", fields: [activeReleaseId], references: [id], onDelete: Restrict)
  releases          SiteRelease[]      @relation("SiteReleases")
  designRuns        SiteDesignRun[]

  @@unique([storeId, slug])
  @@unique([domain])
  @@index([tenantId, status])
}

/// Immutable frozen composition. Rows are never updated; rollback moves Site.activeReleaseId.
model SiteRelease {
  id              String   @id @default(cuid())
  tenantId        String
  siteId          String
  storeId         String
  draftRevision   Int
  contentHash     String
  templateKey     String
  templateVersion String
  runtimeVersion  Int
  composition     Json
  idempotencyKey  String
  /// Active release this publish replaced (null for first publication); immutable audit/replay base.
  baseReleaseId   String?
  createdById     String
  createdAt       DateTime @default(now())
  site            Site     @relation("SiteReleases", fields: [siteId], references: [id], onDelete: Cascade)
  activeFor       Site?    @relation("SiteActiveRelease")

  @@unique([siteId, idempotencyKey])
  @@index([siteId, createdAt])
  @@index([tenantId, storeId])
}
