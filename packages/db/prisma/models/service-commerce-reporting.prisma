enum ServiceCommerceUsageSourceKind {
  SERVICE
  PRESCRIPTION
  COMMERCE_INQUIRY
  BOOKING
  CATALOG
  MEDIA
  CUSTOMER_CHANNEL
  FULFILLMENT
}

enum ServiceCommerceUsageEventType {
  MESSAGE_SENT
  MESSAGE_DELIVERED
  MESSAGE_READ
  MESSAGE_FAILED
  PAYMENT_RECONCILED
  DELIVERY_RECONCILED
  NUMBER_FEE_RECONCILED
  SUBSCRIPTION_CHARGE_RECONCILED
  PLATFORM_CHARGE_RECONCILED
  TAX_RECONCILED
}

enum ServiceCommerceUsageReconciliationStatus {
  PENDING
  RECONCILED
  FAILED
}

enum ServiceCommerceReportReadKind {
  REPORT
  DRILLDOWN
}

enum ServiceCommerceReportReadOutcome {
  ALLOWED
  DENIED
}

enum ServiceCommerceReportReadSource {
  SERVICE_COMMERCE_REPORTING
}

enum ServiceCommerceReportDrilldownSection {
  LIFECYCLE
  CATALOG
  RELIABILITY
  MEDIA
  COSTS
}

enum ServiceCommerceReportReadDenialReason {
  ACCESS_FORBIDDEN
  RATE_LIMITED
  STORE_NOT_FOUND
}

/// Immutable external usage and cost attribution. Core request, Quote,
/// booking, payment and fulfilment lifecycle facts remain authoritative in
/// their owning aggregates and are aggregated directly by reporting queries.
/// A nullable applicable amount means unknown; an explicit zero is known zero.
model ServiceCommerceUsageEvent {
  id                      String                                   @id @default(cuid())
  tenantId                String
  storeId                 String
  connectionId            String?
  sourceKind              ServiceCommerceUsageSourceKind
  sourceId                String
  eventType               ServiceCommerceUsageEventType
  deduplicationKey        String
  occurredAt              DateTime
  providerKey             String?
  billingOwnerSnapshot    String?
  messageCategory         String?
  recipientMarket         String?
  currencyCode            String
  metaCostMinor           Int?
  bspCostMinor            Int?
  numberCostMinor         Int?
  paymentProviderFeeMinor Int?
  deliveryCostMinor       Int?
  taxMinor                Int?
  platformChargeMinor     Int?
  subscriptionChargeMinor Int?
  revenueMinor            Int?
  reconciliationStatus    ServiceCommerceUsageReconciliationStatus @default(PENDING)
  reconciliationSource    String?
  reconciledAt            DateTime?
  createdAt               DateTime                                 @default(now())
  tenant                  Tenant                                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                   Store                                    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  connection              WhatsAppConnection?                      @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, deduplicationKey])
  @@index([tenantId, storeId, occurredAt])
  @@index([tenantId, connectionId, occurredAt])
  @@index([tenantId, eventType, occurredAt])
}

/// Append-only evidence that an authenticated actor attempted to read an
/// aggregate Service Commerce report. It intentionally stores no report rows,
/// customer/source identifiers, media references, provider operations or raw
/// error text.
model ServiceCommerceReportReadAuditEvent {
  id               String                                 @id @default(cuid())
  tenantId         String
  storeId          String?
  actorUserId      String
  kind             ServiceCommerceReportReadKind
  drilldownSection ServiceCommerceReportDrilldownSection?
  purpose          String
  outcome          ServiceCommerceReportReadOutcome
  source           ServiceCommerceReportReadSource        @default(SERVICE_COMMERCE_REPORTING)
  denialReason     ServiceCommerceReportReadDenialReason?
  reportStart      DateTime
  reportEnd        DateTime
  effectiveAt      DateTime                               @default(now())
  createdAt        DateTime                               @default(now())
  tenant           Tenant                                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store            Store?                                 @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([tenantId, storeId, effectiveAt])
  @@index([actorUserId, effectiveAt])
  @@index([tenantId, outcome, effectiveAt])
}
