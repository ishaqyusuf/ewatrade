model QaPurgeRun {
  id                String           @id @default(cuid())
  requestedByUserId String
  status            QaPurgeRunStatus @default(QUEUED)
  activeKey         String?          @unique
  deletedCounts     Json?
  errorCategory     String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status])
  @@index([createdAt])
}

model QaTesterGrant {
  id               String                  @id @default(cuid())
  qaDomain         String
  testerIdentity   String
  credentialDigest String                  @unique
  status           String                  @default("ACTIVE")
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  authorizations   QaClientAuthorization[]
  auditEvents      QaAccessAuditEvent[]

  @@index([qaDomain, status, expiresAt])
  @@index([testerIdentity, status])
}

model QaClientAuthorization {
  id                String                     @id @default(cuid())
  grantId           String
  clientId          String
  clientPlatform    String
  tokenDigest       String                     @unique
  status            String                     @default("ACTIVE")
  expiresAt         DateTime
  revokedAt         DateTime?
  lastValidatedAt   DateTime                   @default(now())
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  grant             QaTesterGrant              @relation(fields: [grantId], references: [id], onDelete: Cascade)
  sessions          Session[]
  profileSelections QaAccessProfileSelection[]
  auditEvents       QaAccessAuditEvent[]

  @@unique([grantId, clientId, clientPlatform])
  @@index([status, expiresAt])
  @@index([clientId, clientPlatform])
}

model QaAccessProfileSelection {
  id              String                @id @default(cuid())
  authorizationId String
  referenceDigest String                @unique
  membershipId    String
  storeId         String?
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime              @default(now())
  authorization   QaClientAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)

  @@index([authorizationId, expiresAt])
  @@index([membershipId, storeId])
}

model QaAccessAttemptBucket {
  id              String    @id @default(cuid())
  bucketDigest    String    @unique
  failedCount     Int       @default(0)
  windowStartedAt DateTime  @default(now())
  lockedUntil     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([lockedUntil])
}

model QaAccessAuditEvent {
  id              String                 @id @default(cuid())
  grantId         String?
  authorizationId String?
  eventType       String
  outcome         String
  domainDigest    String?
  clientDigest    String?
  networkDigest   String?
  metadata        Json?
  createdAt       DateTime               @default(now())
  grant           QaTesterGrant?         @relation(fields: [grantId], references: [id], onDelete: SetNull)
  authorization   QaClientAuthorization? @relation(fields: [authorizationId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([grantId, createdAt])
  @@index([authorizationId, createdAt])
}

model TenantHostname {
  id         String                @id @default(cuid())
  tenantId   String
  surface    TenantHostnameSurface
  hostname   String                @unique
  isPrimary  Boolean               @default(false)
  isCustom   Boolean               @default(false)
  verifiedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, surface, hostname])
  @@index([tenantId, surface])
}

model OnboardingSession {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  tenantId  String?
  userId    String?
  step      Int      @default(1)
  formData  Json?
  completed Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
  @@index([tenantId])
}

model LeadCapture {
  id          String          @id @default(cuid())
  type        LeadCaptureType
  email       String
  fullName    String
  companyName String?
  roleTitle   String?
  phone       String?
  message     String?
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([type, createdAt])
  @@index([email, createdAt])
}

model User {
  id                                             String                                            @id @default(cuid())
  name                                           String                                            @default("")
  email                                          String                                            @unique
  emailVerified                                  Boolean                                           @default(false)
  emailVerifiedAt                                DateTime?
  image                                          String?
  phone                                          String?                                           @unique
  phoneVerifiedAt                                DateTime?
  firstName                                      String?
  lastName                                       String?
  displayName                                    String?
  avatarUrl                                      String?
  isPlatformAdmin                                Boolean                                           @default(false)
  metadata                                       Json?
  createdAt                                      DateTime                                          @default(now())
  updatedAt                                      DateTime                                          @updatedAt
  accounts                                       Account[]
  sessions                                       Session[]
  memberships                                    Membership[]
  retailOpsStaffProfiles                         RetailOpsStaffProfile[]                           @relation("RetailOpsStaffProfileUser")
  sentMessages                                   Message[]
  automationEvents                               AutomationEvent[]                                 @relation("AutomationActor")
  storeConversationAccountAccesses               StoreConversationAccountAccess[]
  storeConversationAccountLinkCommands           StoreConversationAccountLinkCommand[]
  storeConversationAccountDeviceCommands         StoreConversationAccountDeviceCommand[]
  storeConversationAccountAuditEvents            StoreConversationAccountAuditEvent[]
  storeConversationAccountNotificationPreference StoreConversationAccountNotificationPreference?
  storeConversationAccountWatermarks             StoreConversationAccountWatermark[]
  storeConversationPrivacyRequests               StoreConversationPrivacyRequest[]                 @relation("StoreConversationPrivacyRequestAccount")
  storeConversationNotificationCommands          StoreConversationNotificationCommand[]
  storeConversationNotificationIntents           StoreConversationNotificationIntent[]
  storeConversationNotificationAuditEvents       StoreConversationNotificationAuditEvent[]
  storeConversationPushEndpoints                 StoreConversationPushEndpoint[]
  storeConversationChannelConfigurationsUpdated  StoreConversationChannelConfiguration[]           @relation("StoreConversationChannelConfigUpdatedBy")
  storeConversationChannelConfigurationAudits    StoreConversationChannelConfigurationAuditEvent[] @relation("StoreConversationChannelConfigAuditActor")
  storeConversationWhatsAppBridgeAudits          StoreConversationWhatsAppBridgeAuditEvent[]       @relation("StoreConversationWhatsAppBridgeAuditAccount")
  storeConversationWhatsAppCandidates            StoreConversationWhatsAppCandidate[]              @relation("StoreConversationWhatsAppCandidateAccount")
  storeConversationModerationCommands            StoreConversationModerationCommand[]              @relation("StoreConversationModerationCommandActor")
  storeConversationModerationAuditEvents         StoreConversationModerationAuditEvent[]           @relation("StoreConversationModerationAuditActor")
  storeConversationSensitiveReadAuditEvents      StoreConversationSensitiveReadAuditEvent[]        @relation("StoreConversationSensitiveReadAuditActor")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  provider              String?
  providerAccountId     String?
  accessToken           String?
  refreshToken          String?
  expiresAt             DateTime?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  tokenType             String?
  scope                 String?
  idToken               String?
  password              String?
  passwordHash          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id                String                 @id @default(cuid())
  userId            String
  token             String                 @unique
  ipAddress         String?
  userAgent         String?
  expiresAt         DateTime
  qaAuthorizationId String?
  qaTenantId        String?
  qaMembershipId    String?
  qaStoreId         String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  qaAuthorization   QaClientAuthorization? @relation(fields: [qaAuthorizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([qaAuthorizationId])
  @@index([qaTenantId, qaMembershipId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Membership {
  id                                        String                                     @id @default(cuid())
  tenantId                                  String
  userId                                    String
  role                                      MembershipRole
  status                                    MembershipStatus                           @default(ACTIVE)
  invitedById                               String?
  invitedAt                                 DateTime?
  acceptedAt                                DateTime?
  createdAt                                 DateTime                                   @default(now())
  updatedAt                                 DateTime                                   @updatedAt
  tenant                                    Tenant                                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                                      User                                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  retailOpsStaffProfile                     RetailOpsStaffProfile?
  retailOpsStaffInviteTokens                RetailOpsStaffInviteToken[]
  retailOpsStaffLifecycleEvents             RetailOpsStaffLifecycleEvent[]
  serviceCommerceStoreTeamAssignments       ServiceCommerceStoreTeamAssignment[]
  requestedServiceCommerceQuoteApprovals    ServiceCommerceQuoteApproval[]             @relation("QuoteApprovalRequester")
  decidedServiceCommerceQuoteApprovals      ServiceCommerceQuoteApproval[]             @relation("QuoteApprovalDecider")
  serviceCommerceQuoteApprovalAuditEvents   ServiceCommerceQuoteApprovalAuditEvent[]
  serviceBookingResources                   ServiceBookingResource[]
  currentStoreConversationAssignments       StoreConversation[]                        @relation("StoreConversationCurrentAssignee")
  authoredStoreConversationMessages         StoreConversationMessage[]                 @relation("StoreConversationMessageAuthor")
  storeConversationAssignmentActions        StoreConversationAssignmentEvent[]         @relation("StoreConversationAssignmentActor")
  storeConversationAssignmentsFrom          StoreConversationAssignmentEvent[]         @relation("StoreConversationAssignmentFrom")
  storeConversationAssignmentsTo            StoreConversationAssignmentEvent[]         @relation("StoreConversationAssignmentTo")
  storeConversationEscalationActions        StoreConversationEscalationEvent[]         @relation("StoreConversationEscalationActor")
  storeConversationAuditActions             StoreConversationAuditEvent[]              @relation("StoreConversationAuditActor")
  storeConversationStaffWatermarks          StoreConversationStaffWatermark[]
  storeConversationModerationCommands       StoreConversationModerationCommand[]       @relation("StoreConversationModerationCommandMembership")
  storeConversationModerationAuditEvents    StoreConversationModerationAuditEvent[]    @relation("StoreConversationModerationAuditMembership")
  storeConversationSensitiveReadAuditEvents StoreConversationSensitiveReadAuditEvent[] @relation("StoreConversationSensitiveReadAuditMembership")

  @@unique([tenantId, userId])
  @@index([tenantId, role])
  @@index([userId, status])
}
