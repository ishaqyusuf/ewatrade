  createdAt       DateTime                     @default(now())
  tenant          Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store           Store                        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation    StoreConversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message         StoreConversationMessage     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  quoteVersion    CommerceQuoteVersion         @relation(fields: [quoteVersionId], references: [id], onDelete: Restrict)

  @@unique([conversationId, quoteVersionId])
  @@index([tenantId, storeId, occurredAt])
  @@index([sourceKind, sourceId])
  @@index([quoteVersionId])
}

/// Monotonic EwaTrade delivery/read cursor for one exact guest credential.
/// Provider delivery/read remains a separate channel-specific fact.
model StoreConversationCustomerWatermark {
  id                       String                           @id @default(cuid())
  tenantId                 String
  storeId                  String
  conversationId           String
  credentialId             String
  deliveredThroughSequence Int                              @default(0)
  readThroughSequence      Int                              @default(0)
