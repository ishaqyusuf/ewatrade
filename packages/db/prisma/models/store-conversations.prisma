  store               Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation        StoreConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  membership          Membership        @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([conversationId, membershipId])
  @@index([tenantId, storeId, conversationId])
}

/// Monotonic EwaTrade delivery/read cursor for one exact Customer Account
/// participant. Guest credential and provider watermarks remain independent.
model StoreConversationAccountWatermark {
  id                       String            @id @default(cuid())
  tenantId                 String
  storeId                  String
  conversationId           String
  accountUserId            String
  deliveredThroughSequence Int               @default(0)
  readThroughSequence      Int               @default(0)
  deliveredAt              DateTime?
  readAt                   DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  tenant                   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                    Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation             StoreConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  accountUser              User              @relation(fields: [accountUserId], references: [id], onDelete: Cascade)

  @@unique([conversationId, accountUserId])
  @@index([accountUserId, readThroughSequence])
  @@index([tenantId, storeId, conversationId])
}

/// Customer Channels-owned Store service hours and manual Chat pause. Missing
/// rows resolve through the additive 24/7, unpaused compatibility default.
model StoreConversationAvailabilityConfiguration {
  id                             String                                    @id @default(cuid())
  tenantId                       String
  storeId                        String                                    @unique
  timezone                       String
  weeklyHours                    Json
  manualPaused                   Boolean                                   @default(false)
  customerWording                StoreConversationCustomerWording          @default(TEMPORARILY_UNAVAILABLE)
  unreadNotificationGraceSeconds Int                                       @default(45)
  pauseReason                    String?
  pausedAt                       DateTime?
  pausedByUserId                 String?
  resumedAt                      DateTime?
  resumedByUserId                String?
  revision                       Int                                       @default(1)
  createdAt                      DateTime                                  @default(now())
  updatedAt                      DateTime                                  @updatedAt
  tenant                         Tenant                                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                          Store                                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  auditEvents                    StoreConversationAvailabilityAuditEvent[]

  @@index([tenantId, manualPaused, updatedAt])
}

/// Append-only, payload-bound availability configuration evidence. Its
/// snapshot is bounded configuration only and never customer or provider data.
model StoreConversationAvailabilityAuditEvent {
  id                    String                                      @id @default(cuid())
  tenantId              String
  storeId               String
  configurationId       String
  actorUserId           String
  type                  StoreConversationAvailabilityAuditEventType
  configurationRevision Int
  clientOperationId     String
  payloadHash           String
  reason                String
  configurationSnapshot Json
  occurredAt            DateTime                                    @default(now())
  createdAt             DateTime                                    @default(now())
  tenant                Tenant                                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                 Store                                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  configuration         StoreConversationAvailabilityConfiguration  @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@unique([storeId, clientOperationId])
  @@index([tenantId, storeId, occurredAt])
  @@index([configurationId, configurationRevision])
  @@index([actorUserId, occurredAt])
}

/// Conversation-scoped authorization for a Guest Identity. The owning guest
/// remains on StoreConversation while additive grants preserve web access.
model StoreConversationGuestAccess {
  id              String                             @id @default(cuid())
  tenantId        String
  storeId         String
  conversationId  String
  guestIdentityId String
  origin          StoreConversationGuestAccessOrigin
  status          StoreConversationGuestAccessStatus @default(ACTIVE)
  lastOpenedAt    DateTime                           @default(now())
  revokedAt       DateTime?
  createdAt       DateTime                           @default(now())
  updatedAt       DateTime                           @updatedAt
  tenant          Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store           Store                              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation    StoreConversation                  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  guestIdentity   StoreConversationGuestIdentity     @relation(fields: [guestIdentityId], references: [id], onDelete: Cascade)

  @@unique([conversationId, guestIdentityId])
  @@index([guestIdentityId, status, lastOpenedAt])
  @@index([tenantId, storeId, status])
}

/// Digest-only, Store-scoped handoff from a web Guest credential to one
/// installation-bound mobile Guest credential.
model StoreConversationTransfer {
  id                        String                            @id @default(cuid())
  tenantId                  String
  storeId                   String
  conversationId            String
  sourceCredentialId        String
  redeemedGuestIdentityId   String?
  redeemedCredentialId      String?
  clientOperationId         String
  payloadHash               String
  tokenDigest               String                            @unique
  claimedInstallationDigest String?
  status                    StoreConversationTransferStatus   @default(PENDING)
  expiresAt                 DateTime
  claimedAt                 DateTime?
  redeemedAt                DateTime?
  revokedAt                 DateTime?
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
  tenant                    Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                     Store                             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation              StoreConversation                 @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceCredential          StoreConversationGuestCredential  @relation("StoreConversationTransferSourceCredential", fields: [sourceCredentialId], references: [id], onDelete: Restrict)
  redeemedGuestIdentity     StoreConversationGuestIdentity?   @relation("StoreConversationTransferRedeemedGuest", fields: [redeemedGuestIdentityId], references: [id], onDelete: Restrict)
  redeemedCredential        StoreConversationGuestCredential? @relation("StoreConversationTransferRedeemedCredential", fields: [redeemedCredentialId], references: [id], onDelete: Restrict)

  @@unique([sourceCredentialId, clientOperationId])
  @@index([status, expiresAt])
  @@index([conversationId, status])
  @@index([claimedInstallationDigest, status])
  @@index([tenantId, storeId, status])
}

/// Append-only public timeline message ordered by transactional sequence.
model StoreConversationMessage {
  id                      String                                    @id @default(cuid())
  tenantId                String
  storeId                 String
  conversationId          String
  sequence                Int
  authorKind              StoreConversationMessageAuthorKind
  authorMembershipId      String?
  channel                 StoreConversationMessageChannel
  kind                    StoreConversationMessageKind
  retentionClass          StoreConversationRetentionClass           @default(PRESENTATION_MESSAGE)
  body                    String
  presentationRedactedAt  DateTime?
  occurredAt              DateTime                                  @default(now())
  createdAt               DateTime                                  @default(now())
  tenant                  Tenant                                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                   Store                                     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation            StoreConversation                         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorMembership        Membership?                               @relation("StoreConversationMessageAuthor", fields: [authorMembershipId], references: [id], onDelete: Restrict)
  requestLinks            StoreConversationRequestLink[]
  attachments             StoreConversationMessageAttachment[]
  commandReceipts         StoreConversationCommandReceipt[]
  actionMessage           StoreConversationActionMessage?
  accountInvitation       StoreConversationAccountInvitation?
  notificationIntents     StoreConversationNotificationIntent[]
  whatsAppBridge          StoreConversationWhatsAppBridge?
  whatsAppObservation     StoreConversationWhatsAppObservation?
  whatsAppOutboundAttempt StoreConversationWhatsAppOutboundAttempt?

  @@unique([conversationId, sequence])
  @@index([tenantId, storeId, occurredAt])
  @@index([conversationId, sequence])
}

/// Conversation-scoped presentation link to one existing private-media owner.
/// Exactly one of sourceAttachmentId or prescriptionMediaId is populated by
/// repository commands; raw object/provider/safety content is never copied.
model StoreConversationMessageAttachment {
  id                  String                           @id @default(cuid())
  tenantId            String
  storeId             String
  conversationId      String
  messageId           String
  position            Int                              @default(1)
  sourceAttachmentId  String?                          @unique
  prescriptionMediaId String?                          @unique
  createdAt           DateTime                         @default(now())
  tenant              Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store               Store                            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation        StoreConversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message             StoreConversationMessage         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sourceAttachment    ServiceCommerceSourceAttachment? @relation(fields: [sourceAttachmentId], references: [id], onDelete: Restrict)
  prescriptionMedia   PrescriptionMedia?               @relation(fields: [prescriptionMediaId], references: [id], onDelete: Restrict)

  @@unique([messageId, position])
  @@index([tenantId, storeId, conversationId, createdAt])
  @@index([conversationId, messageId])
}

/// Exact typed source association. Source lifecycle authority remains in the
