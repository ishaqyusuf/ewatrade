/// Opaque device-scoped customer identity. It is not a User or proof of a
/// person and contains no contact/profile attributes.
model StoreConversationGuestIdentity {
  id                         String                                           @id @default(cuid())
  status                     StoreConversationGuestIdentityStatus             @default(ACTIVE)
  lastSeenAt                 DateTime                                         @default(now())
  revokedAt                  DateTime?
  createdAt                  DateTime                                         @default(now())
  updatedAt                  DateTime                                         @updatedAt
  credentials                StoreConversationGuestCredential[]
  credentialRotations        StoreConversationGuestCredentialRotation[]
  conversations              StoreConversation[]
  conversationAccesses       StoreConversationGuestAccess[]
  redeemedTransfers          StoreConversationTransfer[]                      @relation("StoreConversationTransferRedeemedGuest")
  accountAccesses            StoreConversationAccountAccess[]
  accountLinkCommands        StoreConversationAccountLinkCommand[]
  accountAuditEvents         StoreConversationAccountAuditEvent[]
  notificationContacts       StoreConversationGuestNotificationContact[]
  notificationVerifications  StoreConversationGuestNotificationVerification[]
  notificationIntents        StoreConversationNotificationIntent[]
  notificationAudits         StoreConversationNotificationAuditEvent[]
  whatsAppBridgeCapabilities StoreConversationWhatsAppBridgeCapability[]      @relation("StoreConversationWhatsAppBridgeCapabilityGuest")
  whatsAppBridges            StoreConversationWhatsAppBridge[]                @relation("StoreConversationWhatsAppBridgeGuest")
  whatsAppBridgeAudits       StoreConversationWhatsAppBridgeAuditEvent[]      @relation("StoreConversationWhatsAppBridgeAuditGuest")
  privacyRequests            StoreConversationPrivacyRequest[]

  @@index([status, lastSeenAt])
}

/// Purpose-bound bearer credential. Only its SHA-256 digest is persisted.
model StoreConversationGuestCredential {
  id                     String                                     @id @default(cuid())
  guestIdentityId        String
  tokenDigest            String                                     @unique
  deviceBindingDigest    String?
  purpose                StoreConversationGuestCredentialPurpose
  retentionClass         StoreConversationRetentionClass            @default(GUEST_CREDENTIAL)
  status                 StoreConversationGuestCredentialStatus     @default(ACTIVE)
  expiresAt              DateTime
  lastUsedAt             DateTime                                   @default(now())
  rotatedAt              DateTime?
  overlapExpiresAt       DateTime?
  rotatedToCredentialId  String?                                    @unique
  revokedAt              DateTime?
  createdAt              DateTime                                   @default(now())
  updatedAt              DateTime                                   @updatedAt
  guestIdentity          StoreConversationGuestIdentity             @relation(fields: [guestIdentityId], references: [id], onDelete: Cascade)
  rotatedToCredential    StoreConversationGuestCredential?          @relation("StoreConversationGuestCredentialSuccessor", fields: [rotatedToCredentialId], references: [id], onDelete: SetNull)
  rotatedFromCredential  StoreConversationGuestCredential?          @relation("StoreConversationGuestCredentialSuccessor")
  sourceRotations        StoreConversationGuestCredentialRotation[] @relation("StoreConversationGuestCredentialRotationSource")
  targetRotations        StoreConversationGuestCredentialRotation[] @relation("StoreConversationGuestCredentialRotationTarget")
  sourceTransfers        StoreConversationTransfer[]                @relation("StoreConversationTransferSourceCredential")
  redeemedTransfers      StoreConversationTransfer[]                @relation("StoreConversationTransferRedeemedCredential")
  conversationWatermarks StoreConversationCustomerWatermark[]
  accountAuditEvents     StoreConversationAccountAuditEvent[]
  accountDeviceCommands  StoreConversationAccountDeviceCommand[]
  notificationCommands   StoreConversationNotificationCommand[]
  pushEndpoints          StoreConversationPushEndpoint[]

  @@index([guestIdentityId, status, expiresAt])
  @@index([purpose, deviceBindingDigest, status])
}

/// Payload-bound proof of one device credential rotation. Raw bearer material
/// is never persisted; the caller must stage the target token for replay.
model StoreConversationGuestCredentialRotation {
  id                 String                                  @id @default(cuid())
  guestIdentityId    String
  sourceCredentialId String
  targetCredentialId String                                  @unique
  clientOperationId  String
  payloadHash        String
  purpose            StoreConversationGuestCredentialPurpose
  overlapExpiresAt   DateTime
  createdAt          DateTime                                @default(now())
  guestIdentity      StoreConversationGuestIdentity          @relation(fields: [guestIdentityId], references: [id], onDelete: Cascade)
  sourceCredential   StoreConversationGuestCredential        @relation("StoreConversationGuestCredentialRotationSource", fields: [sourceCredentialId], references: [id], onDelete: Restrict)
  targetCredential   StoreConversationGuestCredential        @relation("StoreConversationGuestCredentialRotationTarget", fields: [targetCredentialId], references: [id], onDelete: Restrict)

  @@unique([guestIdentityId, clientOperationId])
  @@index([sourceCredentialId, createdAt])
  @@index([guestIdentityId, createdAt])
}

/// Customer-facing thread scoped immutably to exactly one Tenant and Store.
model StoreConversation {
  id                            String                                           @id @default(cuid())
  tenantId                      String
  storeId                       String
  guestIdentityId               String
  lifecycle                     StoreConversationLifecycle                       @default(ACTIVE)
  moderationState               StoreConversationModerationState                 @default(OPEN)
  moderationRevision            Int                                              @default(0)
  moderationReason              StoreConversationModerationReason?
  lastMessageSequence           Int                                              @default(0)
  lastCustomerMessageSequence   Int                                              @default(0)
  lastCustomerMessageAt         DateTime?
  lastStoreReplySequence        Int                                              @default(0)
  lastStoreReplyAt              DateTime?
  responseDueAt                 DateTime?
  assignedMembershipId          String?
  assignmentRevision            Int                                              @default(0)
  createdAt                     DateTime                                         @default(now())
  lastActivityAt                DateTime                                         @default(now())
  archivedAt                    DateTime?
  restrictedAt                  DateTime?
  updatedAt                     DateTime                                         @updatedAt
  tenant                        Tenant                                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                         Store                                            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  guestIdentity                 StoreConversationGuestIdentity                   @relation(fields: [guestIdentityId], references: [id], onDelete: Restrict)
  assignedMembership            Membership?                                      @relation("StoreConversationCurrentAssignee", fields: [assignedMembershipId], references: [id], onDelete: Restrict)
  messages                      StoreConversationMessage[]
  actionMessages                StoreConversationActionMessage[]
  messageAttachments            StoreConversationMessageAttachment[]
  requestLinks                  StoreConversationRequestLink[]
  commandReceipts               StoreConversationCommandReceipt[]
  assignmentEvents              StoreConversationAssignmentEvent[]
  escalationEvents              StoreConversationEscalationEvent[]
  auditEvents                   StoreConversationAuditEvent[]
  moderationCommands            StoreConversationModerationCommand[]
  moderationAuditEvents         StoreConversationModerationAuditEvent[]
  sensitiveReadAuditEvents      StoreConversationSensitiveReadAuditEvent[]
  privacyRequests               StoreConversationPrivacyRequest[]
  guestAccesses                 StoreConversationGuestAccess[]
  transfers                     StoreConversationTransfer[]
  customerWatermarks            StoreConversationCustomerWatermark[]
  staffWatermarks               StoreConversationStaffWatermark[]
  accountInvitations            StoreConversationAccountInvitation[]
  accountAccess                 StoreConversationAccountAccess?
  accountAuditEvents            StoreConversationAccountAuditEvent[]
  accountWatermarks             StoreConversationAccountWatermark[]
  notificationCommands          StoreConversationNotificationCommand[]
  notificationIntents           StoreConversationNotificationIntent[]
  notificationVerifications     StoreConversationGuestNotificationVerification[]
  notificationPushEndpoints     StoreConversationPushEndpoint[]
  notificationAudits            StoreConversationNotificationAuditEvent[]
  whatsAppBridgeCapabilities    StoreConversationWhatsAppBridgeCapability[]
  whatsAppBridges               StoreConversationWhatsAppBridge[]
  whatsAppBridgeAudits          StoreConversationWhatsAppBridgeAuditEvent[]
  whatsAppCandidates            StoreConversationWhatsAppCandidate[]
  whatsAppCandidateSuppressions StoreConversationWhatsAppCandidateSuppression[]
  whatsAppDirectSessions        StoreConversationWhatsAppDirectSession[]
  whatsAppObservations          StoreConversationWhatsAppObservation[]
  whatsAppOutboundAttempts      StoreConversationWhatsAppOutboundAttempt[]

  @@unique([storeId, guestIdentityId])
  @@index([tenantId, storeId, lifecycle, lastActivityAt])
  @@index([tenantId, storeId, lifecycle, responseDueAt])
  @@index([assignedMembershipId, lifecycle, lastActivityAt])
}

/// Payload-bound successful moderation mutation. Existing Request and message
/// history are never rewritten by this operational submission gate.
model StoreConversationModerationCommand {
  id                String                            @id @default(cuid())
  tenantId          String
  storeId           String
  conversationId    String
  actorUserId       String
  actorMembershipId String
  clientOperationId String
  payloadHash       String
  action            StoreConversationModerationAction
  reason            StoreConversationModerationReason
  operatorNote      String?
  expectedRevision  Int
  resultingRevision Int
  resultingState    StoreConversationModerationState
  restrictedAt      DateTime?
  createdAt         DateTime                          @default(now())
  tenant            Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  store             Store                             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation      StoreConversation                 @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  actorUser         User                              @relation("StoreConversationModerationCommandActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorMembership   Membership                        @relation("StoreConversationModerationCommandMembership", fields: [actorMembershipId], references: [id], onDelete: Restrict)

  @@unique([conversationId, clientOperationId])
  @@index([tenantId, storeId, createdAt])
  @@index([actorUserId, createdAt])
}

/// Content-free authorization and mutation audit. Unvalidated Store or
/// conversation scope is deliberately omitted on denied attempts.
model StoreConversationModerationAuditEvent {
  id                String                                  @id @default(cuid())
  tenantId          String
  storeId           String?
  conversationId    String?
  actorUserId       String
  actorMembershipId String?
  clientOperationId String
  payloadHash       String
  action            StoreConversationModerationAction
  reason            StoreConversationModerationReason
  outcome           StoreConversationModerationAuditOutcome
  expectedRevision  Int
  resultingRevision Int?
  reasonCode        String
  occurredAt        DateTime                                @default(now())
  createdAt         DateTime                                @default(now())
  tenant            Tenant                                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  store             Store?                                  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation      StoreConversation?                      @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  actorUser         User                                    @relation("StoreConversationModerationAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorMembership   Membership?                             @relation("StoreConversationModerationAuditMembership", fields: [actorMembershipId], references: [id], onDelete: Restrict)

  @@index([tenantId, storeId, occurredAt])
  @@index([conversationId, occurredAt])
  @@index([actorUserId, occurredAt])
}

/// Append-only, content-free evidence that one personally authorized operator
/// attempted to read a Store Conversation timeline or private attachment.
/// Attachment identifiers are represented only by a one-way digest.
model StoreConversationSensitiveReadAuditEvent {
  id                     String                                @id @default(cuid())
  tenantId               String
  storeId                String?
  conversationId         String?
  actorUserId            String
  actorMembershipId      String?
  kind                   StoreConversationSensitiveReadKind
  purpose                StoreConversationSensitiveReadPurpose
  outcome                StoreConversationSensitiveReadOutcome
  subjectReferenceDigest String?
  reasonCode             String
  occurredAt             DateTime                              @default(now())
  createdAt              DateTime                              @default(now())
  tenant                 Tenant                                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  store                  Store?                                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation           StoreConversation?                    @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  actorUser              User                                  @relation("StoreConversationSensitiveReadAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorMembership        Membership?                           @relation("StoreConversationSensitiveReadAuditMembership", fields: [actorMembershipId], references: [id], onDelete: Restrict)

  @@index([tenantId, storeId, occurredAt])
  @@index([conversationId, occurredAt])
  @@index([actorUserId, occurredAt])
}

/// Fixed half-open-window counter over one purpose-keyed, digest-only scope.
/// Raw guest/device/network/Entry values are intentionally absent.
model StoreConversationSecurityWindow {
  id            String                             @id @default(cuid())
  scopeKind     StoreConversationSecurityScopeKind
  scopeDigest   String
  purpose       StoreConversationSecurityPurpose
  windowStartAt DateTime
  expiresAt     DateTime
  count         Int                                @default(0)
  weightedCost  Int                                @default(0)
  createdAt     DateTime                           @default(now())
  updatedAt     DateTime                           @updatedAt

  @@unique([scopeKind, scopeDigest, purpose, windowStartAt])
  @@index([purpose, expiresAt])
}

/// Immutable, redacted outcome of one bounded security decision. All caller
/// and resource scope values are irreversible digests; content and provider
/// facts are never persisted here.
model StoreConversationSecurityEvent {
  id                      String                              @id @default(cuid())
  operationDigest         String                              @unique
  purpose                 StoreConversationSecurityPurpose
  retentionClass          StoreConversationRetentionClass     @default(SECURITY_EVIDENCE)
  decision                StoreConversationSecurityDecision
  reasonCode              String
  principalScopeDigest    String
  deviceScopeDigest       String?
  storeEntryScopeDigest   String?
  storeScopeDigest        String
  tenantScopeDigest       String
  conversationScopeDigest String?
  networkScopeDigest      String?
  actionCost              Int
  occurredAt              DateTime                            @default(now())
  expiresAt               DateTime
  challenge               StoreConversationSecurityChallenge?

  @@index([principalScopeDigest, purpose, occurredAt])
  @@index([storeScopeDigest, purpose, occurredAt])
  @@index([expiresAt])
}

/// Short-lived one-time challenge capability. Only the proof digest is stored;
/// the raw caller-staged capability is returned once and never logged.
model StoreConversationSecurityChallenge {
  id                   String                                   @id @default(cuid())
  securityEventId      String                                   @unique
  proofDigest          String                                   @unique
  principalScopeDigest String
  purpose              StoreConversationSecurityPurpose
  status               StoreConversationSecurityChallengeStatus @default(ISSUED)
  expiresAt            DateTime
  approvedAt           DateTime?
  consumedAt           DateTime?
  revokedAt            DateTime?
  createdAt            DateTime                                 @default(now())
  updatedAt            DateTime                                 @updatedAt
  securityEvent        StoreConversationSecurityEvent           @relation(fields: [securityEventId], references: [id], onDelete: Restrict)
  privacyRequest       StoreConversationPrivacyRequest?

  @@index([principalScopeDigest, purpose, status, expiresAt])
  @@index([status, expiresAt])
}

/// Proven, exact-conversation customer privacy request. Requested classes and
/// outcomes are allowlisted rows; job claims carry only this row id.
model StoreConversationPrivacyRequest {
  id               String                                          @id @default(cuid())
  tenantId         String
  storeId          String
  conversationId   String
  principalKind    StoreConversationPrivacyPrincipalKind
  accountUserId    String?
  guestIdentityId  String?
  proofChallengeId String?                                         @unique
  operationDigest  String                                          @unique
  payloadHash      String
  status           StoreConversationPrivacyRequestStatus           @default(PENDING)
  attemptCount     Int                                             @default(0)
  claimToken       String?
  claimedAt        DateTime?
  claimExpiresAt   DateTime?
  nextAttemptAt    DateTime?
  completedAt      DateTime?
  failureCode      String?
  createdAt        DateTime                                        @default(now())
  updatedAt        DateTime                                        @updatedAt
  tenant           Tenant                                          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  store            Store                                           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation     StoreConversation                               @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  accountUser      User?                                           @relation("StoreConversationPrivacyRequestAccount", fields: [accountUserId], references: [id], onDelete: Restrict)
  guestIdentity    StoreConversationGuestIdentity?                 @relation(fields: [guestIdentityId], references: [id], onDelete: Restrict)
  proofChallenge   StoreConversationSecurityChallenge?             @relation(fields: [proofChallengeId], references: [id], onDelete: Restrict)
  classifications  StoreConversationPrivacyRequestClassification[]
  outcomes         StoreConversationPrivacyRequestOutcome[]

  @@index([tenantId, storeId, status, nextAttemptAt])
  @@index([conversationId, createdAt])
  @@index([accountUserId, createdAt])
  @@index([guestIdentityId, createdAt])
}

model StoreConversationPrivacyRequestClassification {
  id               String                                 @id @default(cuid())
  privacyRequestId String
  classification   StoreConversationPrivacyClassification
  createdAt        DateTime                               @default(now())
  privacyRequest   StoreConversationPrivacyRequest        @relation(fields: [privacyRequestId], references: [id], onDelete: Restrict)

  @@unique([privacyRequestId, classification])
  @@index([classification, createdAt])
}

/// Immutable truthful per-class result. No content, contacts, provider ids,
/// object references or clinical facts are stored.
model StoreConversationPrivacyRequestOutcome {
  id               String                                 @id @default(cuid())
  privacyRequestId String
  classification   StoreConversationPrivacyClassification
  status           StoreConversationPrivacyOutcomeStatus
  reasonCode       String
  occurredAt       DateTime                               @default(now())
  createdAt        DateTime                               @default(now())
  privacyRequest   StoreConversationPrivacyRequest        @relation(fields: [privacyRequestId], references: [id], onDelete: Restrict)

  @@unique([privacyRequestId, classification])
  @@index([classification, status, occurredAt])
}

/// Optional account-adoption presentation appended beside the first released
/// Quote. Authentication and account access remain separate authorities.
model StoreConversationAccountInvitation {
  id             String                                      @id @default(cuid())
  tenantId       String
  storeId        String
  conversationId String
  messageId      String                                      @unique
  quoteVersionId String
  milestone      StoreConversationAccountInvitationMilestone
  status         StoreConversationAccountInvitationStatus    @default(OFFERED)
  dismissedAt    DateTime?
  linkedAt       DateTime?
  createdAt      DateTime                                    @default(now())
  updatedAt      DateTime                                    @updatedAt
  tenant         Tenant                                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store          Store                                       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation   StoreConversation                           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        StoreConversationMessage                    @relation(fields: [messageId], references: [id], onDelete: Cascade)
