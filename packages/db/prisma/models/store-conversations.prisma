  tenantId           String
  storeId            String
  conversationId     String
  guestCredentialId  String?
  accountUserId      String?
  kind               StoreConversationPushEndpointKind
  endpointCiphertext String
  endpointDigest     String
  status             StoreConversationPushEndpointStatus   @default(ACTIVE)
  lastSeenAt         DateTime                              @default(now())
  invalidatedAt      DateTime?
  revokedAt          DateTime?
  createdAt          DateTime                              @default(now())
  updatedAt          DateTime                              @updatedAt
  tenant             Tenant                                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store              Store                                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation       StoreConversation                     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  guestCredential    StoreConversationGuestCredential?     @relation(fields: [guestCredentialId], references: [id], onDelete: Cascade)
  accountUser        User?                                 @relation(fields: [accountUserId], references: [id], onDelete: Cascade)
  selectedByIntents  StoreConversationNotificationIntent[]

  @@unique([conversationId, endpointDigest])
  @@index([tenantId, storeId, conversationId, status])
  @@index([guestCredentialId, status])
  @@index([accountUserId, status])
}

/// Payload-bound replay receipt for notification preference/contact/endpoint
/// commands. resultId is an opaque internal row id, never a provider value.
model StoreConversationNotificationCommand {
  id                String                                   @id @default(cuid())
  conversationId    String?
  guestCredentialId String?
  accountUserId     String?
  principalKey      String
  clientOperationId String
  kind              StoreConversationNotificationCommandKind
  payloadHash       String
  resultId          String?
  createdAt         DateTime                                 @default(now())
  conversation      StoreConversation?                       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  guestCredential   StoreConversationGuestCredential?        @relation(fields: [guestCredentialId], references: [id], onDelete: Cascade)
  accountUser       User?                                    @relation(fields: [accountUserId], references: [id], onDelete: Cascade)

  @@unique([principalKey, clientOperationId])
  @@index([conversationId, createdAt])
  @@index([accountUserId, createdAt])
  @@index([guestCredentialId, createdAt])
}

/// Provider-neutral unread/reopening outbox. It stores exact principal/scope,
/// safe lifecycle facts and selected private-owner references, never content.
model StoreConversationNotificationIntent {
  id                                String                                     @id @default(cuid())
  tenantId                          String
  storeId                           String
  conversationId                    String
  kind                              StoreConversationNotificationKind
  principalKind                     StoreConversationNotificationPrincipalKind
  guestIdentityId                   String?
  accountUserId                     String?
  deduplicationKey                  String                                     @unique
  coalescingKey                     String
  targetMessageId                   String?
  targetMessageSequence             Int?
  availabilityConfigurationRevision Int?
  subscribedAt                      DateTime?
  scheduledFor                      DateTime
  status                            StoreConversationNotificationIntentStatus  @default(PENDING)
  selectedChannel                   StoreConversationNotificationChannel?
  selectedContactId                 String?
  selectedPushEndpointId            String?
  attemptCount                      Int                                        @default(0)
  maxAttempts                       Int                                        @default(3)
  claimedAt                         DateTime?
  claimExpiresAt                    DateTime?
  nextAttemptAt                     DateTime?
  sentAt                            DateTime?
  deliveredAt                       DateTime?
  lastFailureCode                   String?
  cancelledAt                       DateTime?
  createdAt                         DateTime                                   @default(now())
  updatedAt                         DateTime                                   @updatedAt
  tenant                            Tenant                                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                             Store                                      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation                      StoreConversation                          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  guestIdentity                     StoreConversationGuestIdentity?            @relation(fields: [guestIdentityId], references: [id], onDelete: Cascade)
  accountUser                       User?                                      @relation(fields: [accountUserId], references: [id], onDelete: Cascade)
  targetMessage                     StoreConversationMessage?                  @relation(fields: [targetMessageId], references: [id], onDelete: Restrict)
  selectedContact                   StoreConversationGuestNotificationContact? @relation(fields: [selectedContactId], references: [id], onDelete: Restrict)
  selectedPushEndpoint              StoreConversationPushEndpoint?             @relation(fields: [selectedPushEndpointId], references: [id], onDelete: Restrict)
  attempts                          StoreConversationNotificationAttempt[]
  receipts                          StoreConversationNotificationReceipt[]
  auditEvents                       StoreConversationNotificationAuditEvent[]

  @@index([status, scheduledFor, nextAttemptAt])
  @@index([tenantId, storeId, conversationId, kind, status])
  @@index([coalescingKey, status])
  @@index([guestIdentityId, status])
  @@index([accountUserId, status])
}

model StoreConversationNotificationAttempt {
  id                      String                                     @id @default(cuid())
  tenantId                String
  storeId                 String
  notificationIntentId    String
  attemptNumber           Int
  status                  StoreConversationNotificationAttemptStatus @default(CLAIMED)
  channel                 StoreConversationNotificationChannel
  providerKey             String?
  providerOperationDigest String?
  failureCode             String?
  startedAt               DateTime                                   @default(now())
  completedAt             DateTime?
  createdAt               DateTime                                   @default(now())
  tenant                  Tenant                                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                   Store                                      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  notificationIntent      StoreConversationNotificationIntent        @relation(fields: [notificationIntentId], references: [id], onDelete: Cascade)

  @@unique([notificationIntentId, attemptNumber])
  @@index([tenantId, storeId, startedAt])
  @@index([providerKey, providerOperationDigest])
}

model StoreConversationNotificationReceipt {
  id                    String                                     @id @default(cuid())
  tenantId              String
  storeId               String
  notificationIntentId  String
  providerKey           String
  providerReceiptDigest String
  status                StoreConversationNotificationReceiptStatus
  occurredAt            DateTime
  createdAt             DateTime                                   @default(now())
  tenant                Tenant                                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                 Store                                      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  notificationIntent    StoreConversationNotificationIntent        @relation(fields: [notificationIntentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, providerKey, providerReceiptDigest])
  @@index([notificationIntentId, occurredAt])
}

/// Content-free immutable authorization/lifecycle evidence. reasonCode is
/// allowlisted by repository commands and never contains provider/contact text.
model StoreConversationNotificationAuditEvent {
  id                   String                                 @id @default(cuid())
  tenantId             String
  storeId              String
  conversationId       String
  notificationIntentId String?
  actorAccountUserId   String?
  actorGuestIdentityId String?
  type                 StoreConversationNotificationAuditType
  reasonCode           String
  occurredAt           DateTime                               @default(now())
  createdAt            DateTime                               @default(now())
  tenant               Tenant                                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                Store                                  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation         StoreConversation                      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  notificationIntent   StoreConversationNotificationIntent?   @relation(fields: [notificationIntentId], references: [id], onDelete: Restrict)
  actorAccountUser     User?                                  @relation(fields: [actorAccountUserId], references: [id], onDelete: Restrict)
  actorGuestIdentity   StoreConversationGuestIdentity?        @relation(fields: [actorGuestIdentityId], references: [id], onDelete: Restrict)

  @@index([tenantId, storeId, occurredAt])
  @@index([conversationId, occurredAt])
  @@index([notificationIntentId, occurredAt])
}
