  updatedAt                DateTime                         @updatedAt
  tenant                   Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                    Store                            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation             StoreConversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  credential               StoreConversationGuestCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([conversationId, credentialId])
  @@index([tenantId, storeId, conversationId])
}

/// Monotonic staff read cursor for one exact active Tenant Membership.
model StoreConversationStaffWatermark {
  id                  String            @id @default(cuid())
  tenantId            String
  storeId             String
  conversationId      String
  membershipId        String
  readThroughSequence Int               @default(0)
