  @@unique([conversationId, milestone])
  @@index([tenantId, storeId, createdAt])
  @@index([quoteVersionId])
}

/// Explicit Customer Account participant. The proving Guest Identity remains
/// authorized until its individual credential is revoked.
model StoreConversationAccountAccess {
  id                                  String                                      @id @default(cuid())
  tenantId                            String
  storeId                             String
  conversationId                      String                                      @unique
  accountUserId                       String
  linkedGuestIdentityId               String
  status                              StoreConversationAccountAccessStatus        @default(ACTIVE)
  linkedAt                            DateTime                                    @default(now())
  lastOpenedAt                        DateTime                                    @default(now())
  createdAt                           DateTime                                    @default(now())
  updatedAt                           DateTime                                    @updatedAt
  tenant                              Tenant                                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                               Store                                       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation                        StoreConversation                           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  accountUser                         User                                        @relation(fields: [accountUserId], references: [id], onDelete: Restrict)
  linkedGuestIdentity                 StoreConversationGuestIdentity              @relation(fields: [linkedGuestIdentityId], references: [id], onDelete: Restrict)
  whatsAppBridgeCapabilities          StoreConversationWhatsAppBridgeCapability[] @relation("StoreConversationWhatsAppBridgeCapabilityAccountAccess")
  whatsAppBridges                     StoreConversationWhatsAppBridge[]           @relation("StoreConversationWhatsAppBridgeAccountAccess")
  storeConversationWhatsAppCandidates StoreConversationWhatsAppCandidate[]

  @@unique([storeId, accountUserId])
  @@index([accountUserId, status, lastOpenedAt])
  @@index([linkedGuestIdentityId, status])
  @@index([tenantId, storeId, status])
}

/// Payload-bound completion receipt for one explicit multi-conversation link.
model StoreConversationAccountLinkCommand {
  id                      String                         @id @default(cuid())
  accountUserId           String
  guestIdentityId         String
  clientOperationId       String
  payloadHash             String
  linkedConversationCount Int
  createdAt               DateTime                       @default(now())
  accountUser             User                           @relation(fields: [accountUserId], references: [id], onDelete: Restrict)
  guestIdentity           StoreConversationGuestIdentity @relation(fields: [guestIdentityId], references: [id], onDelete: Restrict)

  @@unique([accountUserId, clientOperationId])
  @@index([guestIdentityId, createdAt])
}

/// Payload-bound completion receipt for revoking one exact linked guest
/// credential from an authenticated Customer Account.
model StoreConversationAccountDeviceCommand {
  id                String                           @id @default(cuid())
  accountUserId     String
  credentialId      String
  clientOperationId String
  payloadHash       String
  createdAt         DateTime                         @default(now())
  accountUser       User                             @relation(fields: [accountUserId], references: [id], onDelete: Restrict)
  credential        StoreConversationGuestCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  @@unique([accountUserId, clientOperationId])
  @@index([credentialId, createdAt])
}

/// Content-free immutable security audit for account adoption and linked guest
/// device revocation. Nullable scope is used only for fail-closed denials that
/// cannot safely validate a caller-supplied conversation/Store.
model StoreConversationAccountAuditEvent {
  id                 String                               @id @default(cuid())
  tenantId           String?
  storeId            String?
  conversationId     String?
  invitationId       String?
  actorAccountUserId String
  guestIdentityId    String?
  credentialId       String?
  type               StoreConversationAccountAuditType
  purpose            StoreConversationAccountAuditPurpose
  outcome            StoreConversationAccountAuditOutcome
  clientOperationId  String
  payloadHash        String?
  reasonCode         String
  occurredAt         DateTime                             @default(now())
  createdAt          DateTime                             @default(now())
  tenant             Tenant?                              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  store              Store?                               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation       StoreConversation?                   @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  invitation         StoreConversationAccountInvitation?  @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  actorAccount       User                                 @relation(fields: [actorAccountUserId], references: [id], onDelete: Restrict)
  guestIdentity      StoreConversationGuestIdentity?      @relation(fields: [guestIdentityId], references: [id], onDelete: Restrict)
  credential         StoreConversationGuestCredential?    @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  @@index([actorAccountUserId, occurredAt])
  @@index([tenantId, storeId, occurredAt])
  @@index([conversationId, occurredAt])
  @@index([guestIdentityId, occurredAt])
  @@index([credentialId, occurredAt])
}

/// Immutable conversation presentation tracer for one released Quote Version.
/// Quote/action/payment authority remains in the referenced shared aggregates;
/// only bounded customer-safe display facts are snapshotted here.
model StoreConversationActionMessage {
  id              String                       @id @default(cuid())
  tenantId        String
  storeId         String
  conversationId  String
  messageId       String                       @unique
  sourceKind      StoreConversationRequestKind
  sourceId        String
  quoteVersionId  String
  createdByUserId String
  payloadHash     String
  quoteSnapshot   Json
