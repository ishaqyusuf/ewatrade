  message        StoreConversationMessage     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, kind, sourceId])
  @@index([tenantId, storeId, kind, sourceId])
  @@index([messageId])
}

/// Payload-bound command receipt. Replays return the original message/source.
