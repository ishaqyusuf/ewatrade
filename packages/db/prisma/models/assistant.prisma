// AI assistant persistence. The model never writes domain records: it stages
// Setup Draft entities that an owner reviews before existing commands commit them.

enum AssistantConversationPurpose {
  SETUP
  GENERAL
  PRODUCT_CREATE
}

enum AssistantConversationStatus {
  OFFERED
  ACTIVE
  COMPLETED
  SKIPPED
  ARCHIVED
}

enum AssistantRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum SetupDraftEntityKind {
  PRODUCT
  SERVICE
  CUSTOMER
  MONEY_ACCOUNT
}

enum SetupDraftEntityState {
  PROPOSED
  NEEDS_INPUT
  CONFIRMED
  COMMITTED
  FAILED
  SKIPPED
}

model AssistantConversation {
  id           String                       @id @default(cuid())
  tenantId     String
  storeId      String
  ownerUserId  String
  purpose      AssistantConversationPurpose
  status       AssistantConversationStatus  @default(OFFERED)
  title        String?
  // Validated product form snapshot. Uses existing private photo asset ids.
  workflowContext Json?
  lastSequence Int                          @default(0)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store      Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  owner      User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  messages    AssistantMessage[]
  runs        AssistantRun[]
  attachments AssistantAttachment[]
  setupDraft  SetupDraft?
  proposals   AssistantActionProposal[]

  @@index([tenantId, storeId, ownerUserId, purpose])
}

enum AssistantAttachmentKind {
  IMAGE
  AUDIO
  PDF
  SPREADSHEET
  TEXT
}

enum AssistantAttachmentStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  FAILED
}

// Owner uploads for a conversation. Bytes live in private storage; transcripts
// and extractions are untrusted data the model reads only inside delimiters.
model AssistantAttachment {
  id                 String                    @id @default(cuid())
  conversationId     String
  tenantId           String
  storeId            String
  actorUserId        String
  clientRequestId    String?
  audioBudgetReserved Boolean @default(false)
  // Set once, when the owner sends the attachment with a message.
  messageId          String?
  kind               AssistantAttachmentKind
  status             AssistantAttachmentStatus @default(PENDING_UPLOAD)
  fileName           String
  contentType        String
  sizeBytes          Int
  contentDigest      String
  durationMs         Int?
  storageProvider    String?
  storageStoreId     String?
  storagePath        String?
  // Provider transcript, kept apart from the (possibly edited) text the owner sends.
  transcript         String?
  // Bounded parse or vision result with row/page/line provenance.
  extraction         Json?
  errorCode          String?
  processingAttempts Int                       @default(0)
  leaseUntil         DateTime?
  uploadExpiresAt    DateTime
  processedAt        DateTime?
  retentionUntil     DateTime
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  transcriptionAttempts AssistantTranscriptionAttempt[]

  @@index([actorUserId, clientRequestId])
  @@index([conversationId, createdAt])
  @@index([status, leaseUntil])
  @@index([retentionUntil])
}

// Each submitted/failed/skipped STT provider is attributable without storing
// transcripts in analytics. Lifetime follows the private source attachment.
model AssistantTranscriptionAttempt {
  id String @id @default(cuid())
  attachmentId String
  generation Int
  ordinal Int
  provider String
  model String
  outcome String @default("started")
  errorCode String?
  gatewayGeneration String?
  providerRequestId String?
  audioSeconds Int
  durationMs Int?
  billingStatus String @default("unknown")
  estimatedCostMicros BigInt?
  pricingVersion String?
  startedAt DateTime @default(now())
  completedAt DateTime?
  attachment AssistantAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([attachmentId, generation, ordinal])
  @@index([provider, startedAt])
  @@index([outcome, startedAt])
}

model AssistantMessage {
  id              String   @id
  conversationId  String
  sequence        Int
  role            String
  // AI SDK UIMessage parts, bounded and allowlisted before persistence.
  parts           Json
  clientRequestId String?
  createdAt       DateTime @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, sequence])
  @@unique([conversationId, clientRequestId])
}

model AssistantRun {
  id             String             @id @default(cuid())
  conversationId String
  actorUserId    String
  requestId      String
  provider       String
  model          String
  promptVersion  String
  status         AssistantRunStatus @default(RUNNING)
  errorCode      String?
  startedAt      DateTime           @default(now())
  completedAt    DateTime?

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  usageEvents  AssistantUsageEvent[]

  @@unique([actorUserId, requestId])
}

// Recorded from the first release so later coin settlement has no data gap.
model AssistantUsageEvent {
  id                String   @id @default(cuid())
  // Chat turns have a run; attachment transcription/vision/parsing do not.
  runId             String?
  attachmentId      String?
  tenantId          String
  actorUserId       String
  provider          String
  model             String
  requestClass      String   @default("chat")
  inputTokens       Int?
  cachedInputTokens Int?
  outputTokens      Int?
  totalTokens       Int?
  audioSeconds      Int?
  imageCount        Int?
  stepCount         Int      @default(0)
  durationMs        Int?
  outcome           String
  createdAt         DateTime @default(now())

  run AssistantRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

// One rolling budget row per Tenant and assistant purpose.
model AssistantBudget {
  scopeKey        String   @id
  windowStartedAt DateTime
  requests        Int      @default(0)
  tokens          Int      @default(0)
  audioSeconds    Int      @default(0)
  visionImages    Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model SetupDraft {
  id             String   @id @default(cuid())
  conversationId String   @unique
  tenantId       String
  storeId        String
  revision       Int      @default(0)
  // Setup areas the owner finished or skipped ({ sell: "DONE", money: "SKIPPED" }),
  // so the assistant moves on and the dashboard can show what is left.
  areas          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  entities     SetupDraftEntity[]
}

model SetupDraftEntity {
  id                String                @id @default(cuid())
  draftId           String
  key               String
  kind              SetupDraftEntityKind
  state             SetupDraftEntityState @default(PROPOSED)
  payload           Json
  // Where the value came from (message id and quoted span); never model-only.
  source            Json?
  openQuestions     Json?
  sortOrder         Int                   @default(0)
  committedRecordId String?
  errorCode         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  draft SetupDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, key])
}

// Reviewed user approvals. Model tools can draft but cannot execute these actions.
enum AssistantActionProposalStatus {
  PENDING
  EXECUTING
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
}

model AssistantActionProposal {
  id                String                        @id @default(cuid())
  conversationId    String
  tenantId          String
  storeId           String
  actorUserId       String
  action            String
  actionVersion     Int                           @default(1)
  payload           Json
  payloadHash       String
  revision          Int                           @default(1)
  targetRecordId    String?
  targetRevision    String?
  roleSnapshot      String
  approvalTokenHash String
  expiresAt         DateTime
  // Generated when drafted, reused across every execution/recovery attempt.
  idempotencyKey    String
  status            AssistantActionProposalStatus @default(PENDING)
  executedResult    Json?
  errorCode         String?
  decidedAt         DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actor User @relation("AssistantProposalActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, actorUserId, idempotencyKey])
  @@index([conversationId, status, createdAt])
  @@index([tenantId, storeId, actorUserId, status, expiresAt])
}
