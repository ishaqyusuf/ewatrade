enum CustomerLedgerEntryKind {
  OPENING_DEBT
  OPENING_CREDIT
  ORDER_CHARGE
  ORDER_PAYMENT
  RECEIPT
  CREDIT_NOTE
  REFUND
  REVERSAL
}

enum CustomerLedgerSide {
  DEBIT
  CREDIT
}

model CustomerLedgerAccount {
  id           String                  @id @default(cuid())
  tenantId     String
  customerId   String
  currencyCode String
  lastSequence BigInt                  @default(0)
  revision     BigInt                  @default(0)
  createdAt    DateTime                @default(now())
  customer     Customer                @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  entries      CustomerLedgerEntry[]
  commands     CustomerLedgerCommand[]
  refundRequests CustomerFundsRefundRequest[]

  @@unique([tenantId, customerId, currencyCode])
  @@unique([tenantId, id])
}

model CustomerLedgerEntry {
  receipt      CustomerLedgerReceipt?
  id           String                     @id @default(cuid())
  tenantId     String
  accountId    String
  sequence     BigInt
  kind         CustomerLedgerEntryKind
  side         CustomerLedgerSide
  amountMinor  BigInt
  sourceKind   String
  sourceId     String
  orderId      String?
  storeId      String?
  actorUserId  String
  effectiveAt  DateTime
  recordedAt   DateTime                   @default(now())
  description  String
  reversalOfId String?                    @unique
  account      CustomerLedgerAccount      @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict)
  order        CommercialOrder?           @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  reversalOf   CustomerLedgerEntry?       @relation("CustomerLedgerReversal", fields: [accountId, reversalOfId], references: [accountId, id], onDelete: Restrict)
  reversals    CustomerLedgerEntry[]      @relation("CustomerLedgerReversal")
  creditsUsed  CustomerLedgerAllocation[] @relation("CustomerLedgerCredit")
  chargesPaid  CustomerLedgerAllocation[] @relation("CustomerLedgerCharge")
  refundRequests CustomerFundsRefundRequest[]

  @@unique([accountId, id])
  @@unique([accountId, sequence])
  @@unique([tenantId, sourceKind, sourceId])
  @@index([accountId, effectiveAt, sequence])
  @@index([tenantId, storeId, effectiveAt])
  @@index([orderId])
}

enum CustomerFundsRefundStatus {
  REQUESTED
  RESERVED
  COMPLETED
  CANCELLED
}

/// Request and reservation only; completion records an independently returned sum.
model CustomerFundsRefundRequest {
  id                     String                    @id @default(cuid())
  tenantId               String
  accountId              String
  bookId                 String
  creditEntryId          String
  amountMinor            BigInt
  destinationCiphertext  String
  destinationFingerprint String
  status                 CustomerFundsRefundStatus @default(REQUESTED)
  version                Int                       @default(1)
  requestedByUserId      String
  approvedByUserId       String?
  completedByUserId      String?
  reason                 String
  outgoingReference      String?
  refundEntryId          String?                   @unique
  createdAt              DateTime                  @default(now())
  approvedAt             DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  account                CustomerLedgerAccount     @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict)
  credit                 CustomerLedgerEntry       @relation(fields: [accountId, creditEntryId], references: [accountId, id], onDelete: Restrict)

  @@index([accountId, creditEntryId, status])
  @@index([tenantId, status, createdAt])
}

model CustomerLedgerAllocation {
  orderSettlement CommercialOrderPayment?
  sequence        BigInt
  id              String                            @id @default(cuid())
  accountId       String
  creditEntryId   String
  chargeEntryId   String
  amountMinor     BigInt
  actorUserId     String
  createdAt       DateTime                          @default(now())
  credit          CustomerLedgerEntry               @relation("CustomerLedgerCredit", fields: [accountId, creditEntryId], references: [accountId, id], onDelete: Restrict)
  charge          CustomerLedgerEntry               @relation("CustomerLedgerCharge", fields: [accountId, chargeEntryId], references: [accountId, id], onDelete: Restrict)
  releases        CustomerLedgerAllocationRelease[]

  @@index([accountId, creditEntryId])
  @@index([accountId, chargeEntryId])
}

model CustomerLedgerAllocationRelease {
  orderSettlementReversal CommercialOrderPayment?
  sequence                BigInt
  id                      String                   @id @default(cuid())
  allocationId            String
  amountMinor             BigInt
  reason                  String
  actorUserId             String
  createdAt               DateTime                 @default(now())
  allocation              CustomerLedgerAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)

  @@index([allocationId, createdAt])
}

model CustomerLedgerCommand {
  id              String                @id @default(cuid())
  tenantId        String
  accountId       String
  clientCommandId String
  kind            String
  payloadHash     String
  actorUserId     String
  result          Json
  createdAt       DateTime              @default(now())
  account         CustomerLedgerAccount @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, clientCommandId])
  @@index([accountId, createdAt])
}

model CustomerLedgerReceipt {
  id             String                  @id @default(cuid())
  accountId      String
  entryId        String                  @unique
  bookId         String
  moneyAccountId String
  method         CommercialPaymentMethod
  reference      String?
  createdAt      DateTime                @default(now())
  entry          CustomerLedgerEntry     @relation(fields: [accountId, entryId], references: [accountId, id], onDelete: Restrict)
  moneyAccount   FinanceAccount          @relation(fields: [bookId, moneyAccountId], references: [bookId, id], onDelete: Restrict)

  @@unique([accountId, entryId])
  @@index([bookId, moneyAccountId, createdAt])
}

/// A reviewed link of an earlier unlinked Order to a saved Customer. It only
/// sets Order.customerId; it posts no charge, payment or journal. Suggestions
/// come from exact phone/email matches, never from a name.
model CommercialOrderCustomerLink {
  id              String          @id @default(cuid())
  tenantId        String
  orderId         String
  customerId      String
  clientCommandId String
  payloadHash     String
  /// PHONE, EMAIL or PHONE_AND_EMAIL at the time of review.
  matchedBy       String
  actorUserId     String
  createdAt       DateTime        @default(now())
  order           CommercialOrder @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  customer        Customer        @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, orderId])
  @@index([tenantId, clientCommandId])
  @@index([tenantId, customerId, createdAt])
}
