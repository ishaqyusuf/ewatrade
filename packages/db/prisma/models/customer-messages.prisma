/// Reusable wording only. Opening WhatsApp never creates a delivery record.
model CustomerMessageTemplate {
  id              String   @id @default(cuid())
  tenantId        String
  storeId         String?
  /// Derived by the server: business or store:<id> (nullable uniqueness is unsafe).
  scopeKey        String
  eventKey        String
  body            String
  enabled         Boolean  @default(true)
  source          String   @default("MANUAL")
  revision        Int      @default(1)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store           Store?   @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Cascade)
  updatedBy       User?    @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, scopeKey, eventKey])
  @@index([tenantId, storeId])
  @@index([updatedByUserId])
}
