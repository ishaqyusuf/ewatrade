model CommerceQuote {
  id               String                  @id @default(cuid())
  tenantId         String
  storeId          String
  sourceType       CommerceQuoteSourceType
  sourceId         String
  clientQuoteId    String
  currentVersionId String?                 @unique
  createdByUserId  String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store            Store                   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  currentVersion   CommerceQuoteVersion?   @relation("CommerceQuoteCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         CommerceQuoteVersion[]  @relation("CommerceQuoteVersions")

  @@unique([tenantId, clientQuoteId])
  @@unique([tenantId, sourceType, sourceId])
  @@index([tenantId, storeId, createdAt])
  @@index([sourceType, sourceId])
}

model CommerceQuoteVersion {
  id                          String                           @id @default(cuid())
  quoteId                     String
  clientVersionId             String
  payloadHash                 String
  version                     Int
  status                      CommerceQuoteVersionStatus       @default(DRAFT)
  availabilityOutcome         CommerceQuoteAvailabilityOutcome
  fulfilmentType              CommerceQuoteFulfilmentType      @default(UNSPECIFIED)
  currencyCode                String
  subtotalMinor               Int
  discountMinor               Int                              @default(0)
  taxMinor                    Int                              @default(0)
  fulfilmentFeeMinor          Int                              @default(0)
  totalMinor                  Int
  customerNote                String?
  fulfilmentPromise           String?
  acceptanceTokenDigest       String?                          @unique
  expiresAt                   DateTime?
  issuedAt                    DateTime?
  acceptedAt                  DateTime?
  declinedAt                  DateTime?
  supersededAt                DateTime?
  revokedAt                   DateTime?
  acceptedOrderId             String?                          @unique
  acceptanceClientId          String?
  createdByUserId             String
  createdAt                   DateTime                         @default(now())
  quote                       CommerceQuote                    @relation("CommerceQuoteVersions", fields: [quoteId], references: [id], onDelete: Cascade)
  currentForQuote             CommerceQuote?                   @relation("CommerceQuoteCurrentVersion")
  acceptedOrder               CommercialOrder?                 @relation(fields: [acceptedOrderId], references: [id], onDelete: Restrict)
  lines                       CommerceQuoteLine[]
  options                     CommerceQuoteOption[]
  optionSelection             CommerceQuoteOptionSelection?
  replayAccessToken           CommerceQuoteReplayAccessToken?
  prescriptionDeliveryAddress PrescriptionDeliveryAddress?
  catalogPricePromotions      CatalogPricePromotion[]

  @@unique([quoteId, version])
  @@unique([quoteId, clientVersionId])
  @@index([status, expiresAt])
  @@index([acceptedOrderId])
}

/// One immutable, mutually exclusive commercial choice within a Quote
/// Version. Simple legacy Quotes are projected/backfilled as one default
/// option; multi-option versions are not payable until one option is selected.
model CommerceQuoteOption {
  id                  String                           @id @default(cuid())
  quoteVersionId      String
  clientOptionId      String
  label               String
  position            Int
  availabilityOutcome CommerceQuoteAvailabilityOutcome
  fulfilmentType      CommerceQuoteFulfilmentType      @default(UNSPECIFIED)
  currencyCode        String
  subtotalMinor       Int
  discountMinor       Int                              @default(0)
  taxMinor            Int                              @default(0)
  fulfilmentFeeMinor  Int                              @default(0)
  totalMinor          Int
  customerNote        String?
  fulfilmentPromise   String?
  createdAt           DateTime                         @default(now())
  quoteVersion        CommerceQuoteVersion             @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)
  lines               CommerceQuoteLine[]
  selection           CommerceQuoteOptionSelection?

  @@unique([quoteVersionId, clientOptionId])
  @@unique([quoteVersionId, position])
  @@index([quoteVersionId, totalMinor])
}

/// The sole idempotent customer choice for a multi-option Quote Version.
/// Selection is distinct from Quote acceptance and cannot itself create an
/// Order, reservation or payment.
model CommerceQuoteOptionSelection {
  quoteVersionId    String               @id
  optionId          String               @unique
  clientSelectionId String
  payloadHash       String
  selectedAt        DateTime             @default(now())
  quoteVersion      CommerceQuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)
  option            CommerceQuoteOption  @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([quoteVersionId, clientSelectionId])
  @@index([selectedAt])
}

/// One rotatable digest used to recover an idempotent Quote issuance response
/// without storing a raw bearer token or invalidating the original token.
model CommerceQuoteReplayAccessToken {
  versionId   String               @id
  tenantId    String
  storeId     String
  tokenDigest String               @unique
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  version     CommerceQuoteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store       Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([tenantId, storeId, updatedAt])
}

model CommerceQuoteLine {
  id                        String                          @id @default(cuid())
  quoteVersionId            String
  quoteOptionId             String?
  sourceLineId              String?
  offeringId                String?
  outcome                   CommerceQuoteLineOutcome        @default(INCLUDED)
  catalogItemName           String
  variantName               String
  optionSelections          Json
  offeringName              String
  quantity                  Decimal?                        @db.Decimal(38, 6)
  unitPriceMinor            Int?
  totalMinor                Int                             @default(0)
  customerNote              String?
  configurationVersionId    String?
  balanceRevision           Int?
  availabilityAttestationId String?
  createdAt                 DateTime                        @default(now())
  quoteVersion              CommerceQuoteVersion            @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)
  quoteOption               CommerceQuoteOption?            @relation(fields: [quoteOptionId], references: [id], onDelete: Cascade)
  offering                  SellableOffering?               @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  availabilityAttestation   CatalogAvailabilityAttestation? @relation(fields: [availabilityAttestationId], references: [id], onDelete: Restrict)

  @@index([quoteVersionId])
  @@index([quoteOptionId])
  @@index([offeringId])
  @@index([sourceLineId])
  @@index([availabilityAttestationId])
}
