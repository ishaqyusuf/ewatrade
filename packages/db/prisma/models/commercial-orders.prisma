model CommercialOrder {
  customerId                     String?
  customer                       Customer?                           @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  ledgerEntries                  CustomerLedgerEntry[]
  id                             String                              @id @default(cuid())
  tenantId                       String
  storeId                        String
  clientOrderId                  String
  payloadHash                    String
  schemaVersion                  Int                                 @default(1)
  orderNumber                    String
  status                         OrderStatus                         @default(CONFIRMED)
  paymentStatus                  PaymentStatus                       @default(PENDING)
  currencyCode                   String
  subtotalMinor                  Int
  serviceChargeMinor             Int                                 @default(0)
  discountMinor                  Int                                 @default(0)
  taxMinor                       Int                                 @default(0)
  totalMinor                     Int
  amountPaidMinor                Int                                 @default(0)
  customerName                   String?
  customerPhone                  String?
  customerEmail                  String?
  notes                          String?
  deliveryDueAt                  DateTime?
  createdByUserId                String
  completedAt                    DateTime?
  createdAt                      DateTime                            @default(now())
  updatedAt                      DateTime                            @updatedAt
  tenant                         Tenant                              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                          Store                               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  lines                          CommercialOrderLine[]
  serviceFulfillments            CommercialServiceFulfillment[]
  serviceAuthorizations          CommercialServiceAuthorization[]
  payments                       CommercialOrderPayment[]
  returns                        ProductReturn[]
  serviceIntake                  ServiceIntake?
  serviceJobs                    ServiceJob[]
  acceptedQuoteVersion           ServiceQuoteVersion?
  acceptedCommerceQuoteVersion   CommerceQuoteVersion?
  fulfillmentCommands            CommercialOrderFulfillmentCommand[]
  reminderDeliveries             CommercialOrderReminderDelivery[]
  prescriptionPaymentIntents     PrescriptionPaymentIntent[]
  prescriptionPickupFulfillment  PrescriptionPickupFulfillment?
  prescriptionDeliveryAddress    PrescriptionDeliveryAddress?
  prescriptionDeliveryAssignment PrescriptionDeliveryAssignment?
  serviceBookings                ServiceBooking[]

  @@unique([tenantId, id])
  @@unique([tenantId, clientOrderId])
  @@unique([tenantId, orderNumber])
  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, deliveryDueAt, status])
  @@index([storeId, createdAt])
}

model CommercialOrderFulfillmentCommand {
  id                 String          @id @default(cuid())
  tenantId           String
  orderId            String
  clientOperationId  String
  payloadHash        String
  fulfilledLineCount Int
  resultStatus       OrderStatus
  actorUserId        String
  createdAt          DateTime        @default(now())
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order              CommercialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientOperationId])
  @@index([orderId, createdAt])
}

model CommercialOrderReminderSettings {
  id               String   @id @default(cuid())
  tenantId         String
  storeId          String   @unique
  enabled          Boolean  @default(true)
  dayBeforeEnabled Boolean  @default(true)
  sameDayEnabled   Boolean  @default(true)
  updatedByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model CommercialOrderReminderDelivery {
  id             String                                @id @default(cuid())
  tenantId       String
  storeId        String
  orderId        String
  timing         CommercialOrderReminderTiming
  recipientEmail String
  recipientName  String?
  status         CommercialOrderReminderDeliveryStatus @default(PENDING)
  attemptCount   Int                                   @default(0)
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  errorMessage   String?
  createdAt      DateTime                              @default(now())
  updatedAt      DateTime                              @updatedAt
  tenant         Tenant                                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store          Store                                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order          CommercialOrder                       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, timing, recipientEmail])
  @@index([tenantId, status, createdAt])
  @@index([storeId, timing, createdAt])
}

model CommercialOrderPayment {
  customerAllocationId        String?                          @unique
  customerAllocationReleaseId String?                          @unique
  customerAllocation          CustomerLedgerAllocation?        @relation(fields: [customerAllocationId], references: [id], onDelete: Restrict)
  customerAllocationRelease   CustomerLedgerAllocationRelease? @relation(fields: [customerAllocationReleaseId], references: [id], onDelete: Restrict)
  id                          String                           @id @default(cuid())
  tenantId                    String
  storeId                     String
  orderId                     String
  clientPaymentId             String
  type                        CommercialPaymentType            @default(PAYMENT)
  method                      CommercialPaymentMethod
  amountMinor                 Int
  reference                   String?
  note                        String?
  recordedByUserId            String
  recordedAt                  DateTime                         @default(now())
  createdAt                   DateTime                         @default(now())
  tenant                      Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                       Store                            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order                       CommercialOrder                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceBookingEvents        ServiceBookingEvent[]

  @@unique([tenantId, clientPaymentId])
  @@index([orderId, recordedAt])
  @@index([tenantId, storeId, recordedAt])
}

model CommercialOrderLine {
  id                   String                          @id @default(cuid())
  orderId              String
  offeringId           String
  kind                 SellableOfferingKind
  quantity             Decimal                         @db.Decimal(38, 6)
  unitPriceMinor       Int?
  discountMinor        Int                             @default(0)
  taxMinor             Int                             @default(0)
  totalMinor           Int
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  order                CommercialOrder                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offering             SellableOffering                @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  snapshot             OfferingSnapshot?
  stockReservation     StockReservation?
  productFulfillments  ProductFulfillment[]
  productReturns       ProductReturn[]
  serviceJobLines      ServiceJobLine[]
  serviceFulfillment   CommercialServiceFulfillment?
  serviceAuthorization CommercialServiceAuthorization?

  @@unique([orderId, id])
  @@index([orderId])
  @@index([offeringId])
}

model OfferingSnapshot {
  id                         String                      @id @default(cuid())
  orderLineId                String                      @unique
  catalogItemId              String
  catalogItemName            String
  variantId                  String
  variantName                String
  optionSelections           Json
  offeringId                 String
  offeringName               String
  offeringKind               SellableOfferingKind
  pricingPolicy              OfferingPricingPolicy
  currencyCode               String
  unitPriceMinor             Int?
  note                       String?
  quantity                   Decimal                     @db.Decimal(38, 6)
  discountMinor              Int                         @default(0)
  taxMinor                   Int                         @default(0)
  totalMinor                 Int
  inventoryUnitId            String?
  inventoryUnitName          String?
  transactionScale           Int?
  sku                        String?
  barcode                    String?
  configurationVersionId     String?
  unitFactor                 Decimal?                    @db.Decimal(38, 12)
  stockBehavior              InventoryUnitStockBehavior?
  serviceWorkPolicy          ServiceWorkPolicy?
  serviceAuthorizationPolicy WorkAuthorizationPolicy?
  balanceSourceId            String?
  createdAt                  DateTime                    @default(now())
  orderLine                  CommercialOrderLine         @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  inventoryUnit              InventoryUnit?              @relation(fields: [inventoryUnitId], references: [id], onDelete: Restrict)
  configurationVersion       UnitConfigurationVersion?   @relation(fields: [configurationVersionId], references: [id], onDelete: Restrict)
  balanceSource              StockBalanceSource?         @relation(fields: [balanceSourceId], references: [id], onDelete: Restrict)

  @@index([catalogItemId, createdAt])
  @@index([offeringId, createdAt])
  @@index([balanceSourceId])
}

model ProductFulfillment {
  id                    String                               @id @default(cuid())
  orderLineId           String
  reservationId         String
  stockOperationId      String
  quantity              Decimal                              @db.Decimal(38, 6)
  createdAt             DateTime                             @default(now())
  orderLine             CommercialOrderLine                  @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  reservation           StockReservation                     @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  stockOperation        StockOperation                       @relation(fields: [stockOperationId], references: [id], onDelete: Restrict)
  returnCostAllocations FinanceProductReturnCostAllocation[]

  @@unique([orderLineId, id])
  @@unique([orderLineId, reservationId])
  @@index([stockOperationId])
}

/// Explicit performance of a charge-only Service; no tracked Job is invented.
model CommercialServiceFulfillment {
  id                String              @id @default(cuid())
  tenantId          String
  orderId           String
  orderLineId       String              @unique
  clientOperationId String
  payloadHash       String
  quantity          Decimal             @db.Decimal(38, 6)
  actorUserId       String
  reason            String
  performedAt       DateTime
  createdAt         DateTime            @default(now())
  order             CommercialOrder     @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  orderLine         CommercialOrderLine @relation(fields: [orderId, orderLineId], references: [orderId, id], onDelete: Restrict)

  @@unique([tenantId, clientOperationId])
  @@unique([orderId, orderLineId])
  @@index([orderId, performedAt])
}

/// Explicit management release of a charge-only Service; payment and performance remain separate.
model CommercialServiceAuthorization {
  id                String              @id @default(cuid())
  tenantId          String
  orderId           String
  orderLineId       String              @unique
  clientOperationId String
  payloadHash       String
  quantity          Decimal             @db.Decimal(38, 6)
  actorUserId       String
  reason            String
  authorizedAt      DateTime
  createdAt         DateTime            @default(now())
  order             CommercialOrder     @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  orderLine         CommercialOrderLine @relation(fields: [orderId, orderLineId], references: [orderId, id], onDelete: Restrict)

  @@unique([tenantId, clientOperationId])
  @@unique([orderId, orderLineId])
  @@index([orderId, authorizedAt])
}

model ProductReturn {
  id                         String                    @id @default(cuid())
  tenantId                   String
  storeId                    String
  orderId                    String
  orderLineId                String
  clientReturnId             String
  payloadHash                String
  schemaVersion              Int                       @default(1)
  quantity                   Decimal                   @db.Decimal(38, 6)
  disposition                ProductReturnDisposition
  destinationBalanceSourceId String?
  stockOperationId           String?
  reason                     String
  actorUserId                String
  createdAt                  DateTime                  @default(now())
  tenant                     Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                      Store                     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order                      CommercialOrder           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderLine                  CommercialOrderLine       @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  destinationBalanceSource   StockBalanceSource?       @relation(fields: [destinationBalanceSourceId], references: [id], onDelete: Restrict)
  stockOperation             StockOperation?           @relation(fields: [stockOperationId], references: [id], onDelete: Restrict)
  financeCost                FinanceProductReturnCost?

  @@unique([tenantId, orderLineId, id])
  @@unique([tenantId, clientReturnId])
  @@index([orderLineId, createdAt])
  @@index([destinationBalanceSourceId])
}
