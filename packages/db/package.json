{
  "name": "@ewatrade/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": ["src", "generated", "prisma", "prisma.config.ts"],
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./queries": "./src/queries/index.ts",
    "./enums": "./generated/prisma/enums.ts",
    "./browser": "./generated/prisma/browser.ts"
  },
  "scripts": {
    "build": "bun run db:generate && tsc --noEmit",
    "seed:catalog-units": "bun scripts/seed-catalog-unit-definitions.ts",
    "qa:issue-tester-credential": "bun scripts/issue-qa-tester-credential.ts",
    "qa:revoke-tester-credential": "bun scripts/revoke-qa-tester-credential.ts",
    "qa:browser-acceptance-fixture": "bun scripts/qa-access-browser-acceptance-fixture.ts",
    "test:qa-access:integration": "bun test src/queries/acceptance/qa-access/lifecycle.integration.test.ts",
    "backfill:service-quotes": "bun scripts/backfill-service-quotes-to-commerce.ts",
    "db:push": "prisma db push",
    "lint": "biome check .",
    "typecheck": "bun run db:generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:pull": "prisma db pull",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@ewatrade/prescriptions": "workspace:*",
    "@ewatrade/service-commerce": "workspace:*",
    "@ewatrade/utils": "workspace:*",
    "@prisma/adapter-pg": "7.6.0",
    "@prisma/client": "7.6.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@ewatrade/tsconfig": "workspace:*",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.2.3",
    "prisma": "7.6.0",
    "typescript": "catalog:"
  }
}
