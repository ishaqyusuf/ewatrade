{
  "name": "@ewatrade/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "src",
    "generated",
    "prisma",
    "prisma.config.ts"
  ],
  "exports": {
    "./performance-tracing": "./src/performance-tracing.ts",
    "./onboarding-continuation": "./src/queries/onboarding-continuation.ts",
    "./catalog-category-suggestions": "./src/queries/catalog-category-suggestions.ts",
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./queries": "./src/queries/index.ts",
    "./qa-access": "./src/queries/qa-access.ts",
    "./staff-onboarding": "./src/staff-onboarding.ts",
    "./account-privacy-access": "./src/queries/account-privacy-access.ts",
    "./legal-session-access": "./src/queries/legal-session-access.ts",
    "./finance-expense-receipt-upload": "./src/queries/finance/expense-receipt-upload-entrypoints.ts",
    "./finance-expense-receipt-delivery": "./src/queries/finance/expense-receipt-delivery-entrypoints.ts",
    "./catalog-photos": "./src/queries/catalog-photos.ts",
    "./catalog-photo-derivatives": "./src/queries/catalog-photo-derivatives.ts",
    "./catalog-photo-deletion": "./src/queries/catalog-photo-deletion.ts",
    "./catalog-photo-lifecycle": "./src/queries/catalog-photo-lifecycle.ts",
    "./catalog-photo-review": "./src/queries/catalog-photo-review.ts",
    "./catalog-photo-replacement": "./src/queries/catalog-photo-replacement.ts",
    "./catalog-categories": "./src/queries/catalog-categories.ts",
    "./enums": "./generated/prisma/enums.ts",
    "./browser": "./generated/prisma/browser.ts",
    "./app-update": "./src/queries/app-update.ts",
    "./staff-store-access": "./src/queries/staff-store-access.ts",
    "./tenant-context": "./src/queries/tenants.ts",
    "./types": "./src/types.ts",
    "./assistant": "./src/queries/assistant.ts",
    "./assistant-attachments": "./src/queries/assistant-attachments.ts",
    "./store-conversation-account-terms": "./src/queries/store-conversation-account-terms.ts"
  },
  "scripts": {
    "seed:category-suggestion-config": "bun scripts/seed-category-suggestion-config.ts",
    "build": "bun run db:generate && tsc --noEmit",
    "seed:catalog-units": "bun scripts/seed-catalog-unit-definitions.ts",
    "qa:issue-tester-credential": "bun scripts/issue-qa-tester-credential.ts",
    "qa:revoke-tester-credential": "bun scripts/revoke-qa-tester-credential.ts",
    "qa:browser-acceptance-fixture": "bun scripts/qa-access-browser-acceptance-fixture.ts",
    "test:qa-access:integration": "bun test src/queries/acceptance/qa-access/lifecycle.integration.test.ts",
    "backfill:service-quotes": "bun scripts/backfill-service-quotes-to-commerce.ts",
    "db:push": "prisma db push",
    "lint": "biome check .",
    "typecheck": "bun run db:generate && tsc --noEmit",
    "db:generate": "prisma generate --config prisma.generate.config.ts && bun scripts/align-prisma-client-types.ts",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:pull": "prisma db pull",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@ewatrade/catalog": "workspace:*",
    "@ewatrade/prescriptions": "workspace:*",
    "@ewatrade/service-commerce": "workspace:*",
    "@ewatrade/utils": "workspace:*",
    "@prisma/adapter-pg": "7.6.0",
    "@prisma/client": "7.6.0",
    "pg": "^8.16.3",
    "zod": "catalog:",
    "@ewatrade/order-receipts": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@ewatrade/tsconfig": "workspace:*",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.2.3",
    "prisma": "7.6.0",
    "typescript": "catalog:"
  }
}
