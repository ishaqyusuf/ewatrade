{
  "name": "@ewatrade/jobs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./catalog-photo-review": "./src/catalog-photo-review.ts",
    "./assistant-attachments": "./src/assistant-attachments.ts",
    "./product-analytics": "./src/product-analytics.ts"
  },
  "scripts": {
    "dev": "node ../../scripts/with-workspace-env.mjs bun ../../scripts/with-trigger-profile.mjs -- trigger dev",
    "deploy": "node ../../scripts/with-workspace-env.mjs APP_ENV=production DEV_PROFILE=production REQUIRE_PROD_DATABASE_URL=1 bun ../../scripts/with-trigger-profile.mjs -- trigger deploy",
    "deploy:preview": "node ../../scripts/with-workspace-env.mjs APP_ENV=preview DEV_PROFILE=preview bun ../../scripts/with-trigger-profile.mjs -- trigger deploy",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ewatrade/communications": "workspace:*",
    "@ewatrade/catalog": "workspace:*",
    "@ewatrade/db": "workspace:*",
    "@ewatrade/domains": "workspace:*",
    "@ewatrade/email": "workspace:*",
    "@ewatrade/errors": "workspace:*",
    "@ewatrade/notifications": "workspace:*",
    "@ewatrade/observability": "workspace:*",
    "@ewatrade/prescriptions": "workspace:*",
    "@ewatrade/service-commerce": "workspace:*",
    "@ewatrade/utils": "workspace:*",
    "@trigger.dev/build": "4.5.16",
    "@sentry/node": "^10.72.0",
    "@trigger.dev/sdk": "4.5.16",
    "sharp": "0.35.5",
    "libheif-js": "1.23.2",
    "@ewatrade/ai": "workspace:*",
    "@ewatrade/assistant": "workspace:*",
    "@ewatrade/events": "workspace:*",
    "@ewatrade/private-media": "workspace:*"
  },
  "devDependencies": {
    "@ewatrade/tsconfig": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "^24.6.0",
    "trigger.dev": "4.5.16",
    "typescript": "catalog:"
  }
}
