{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    ".env",
    ".env.local",
    ".env.dev",
    ".env.preview",
    ".env.production"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "EWATRADE_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "API_URL",
        "NEXT_PUBLIC_API_URL",
        "STOREFRONT_URL",
        "NEXT_PUBLIC_STOREFRONT_URL",
        "CHAT_URL",
        "NEXT_PUBLIC_CHAT_URL",
        "STOREFRONT_ALLOWED_DEV_ORIGINS",
        "NEXT_PUBLIC_APP_URL",
        "MOBILE_APP_URL",
        "NEXT_PUBLIC_MARKETING_URL",
        "EWATRADE_MARKETING_EXPERIENCE",
        "EWATARADE_MARKETING_EXPERIENCE_PREVIEW_TOKEN",
        "NEXT_PUBLIC_DASHBOARD_URL",
        "NEXT_PUBLIC_PLATFORM_DOMAIN",
        "PLATFORM_DOMAIN",
        "ALLOWED_API_ORIGINS",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "EMAIL_FROM",
        "EMAIL_DELIVERY_MODE",
        "EMAIL_REPLY_TO",
        "EMAIL_QA_DOMAIN_ROUTES",
        "MARKETING_INBOX_EMAILS",
        "RESEND_API_KEY",
        "TEST_EMAILS",
        "TEST_EMAIL",
        "TRIGGER_PROJECT_ID",
        "TRIGGER_PROFILE",
        "TRIGGER_SECRET_KEY",
        "STORE_CONVERSATION_ATTACHMENT_CAPABILITY_SECRET",
        "STORE_CONVERSATION_WHATSAPP_BRIDGE_SECRET",
        "STORE_CONVERSATION_NOTIFICATION_VERIFICATION_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_WEB_CLIENT_ID",
        "GOOGLE_ANDROID_CLIENT_ID",
        "GOOGLE_IOS_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID",
        "EXPO_PUBLIC_CHAT_URL",
        "EXPO_PUBLIC_CHAT_PORT"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".expo/**",
        "dist/**",
        "generated/**",
        "build/**",
        "next-env.d.ts"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "outputs": [
        "generated/**"
      ]
    }
  },
  "globalEnv": [
    "APP_ENV",
    "NEXT_PUBLIC_APP_ENV",
    "COMPOSE_FILE",
    "EWATRADE_DATABASE_URL",
    "DB_SERVICE",
    "DB_WAIT_ATTEMPTS",
    "DB_WAIT_SECONDS",
    "DEV_PROFILE",
    "DOCKER_WAIT_ATTEMPTS",
    "DOCKER_WAIT_SECONDS",
    "REQUIRE_PROD_DATABASE_URL",
    "NODE_ENV",
    "SENTRY_DSN",
    "NEXT_PUBLIC_SENTRY_DSN",
    "SENTRY_RELEASE",
    "NEXT_PUBLIC_SENTRY_RELEASE",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_AUTH_TOKEN",
    "EXPO_PUBLIC_SENTRY_DSN",
    "EXPO_PUBLIC_SENTRY_ENVIRONMENT",
    "EXPO_PUBLIC_SENTRY_RELEASE",
    "TZ",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "API_URL",
    "NEXT_PUBLIC_API_URL",
    "STOREFRONT_URL",
    "NEXT_PUBLIC_STOREFRONT_URL",
    "CHAT_URL",
    "NEXT_PUBLIC_CHAT_URL",
    "STOREFRONT_ALLOWED_DEV_ORIGINS",
    "NEXT_PUBLIC_APP_URL",
    "MOBILE_APP_URL",
    "NEXT_PUBLIC_MARKETING_URL",
    "EWATRADE_MARKETING_EXPERIENCE",
    "EWATARADE_MARKETING_EXPERIENCE_PREVIEW_TOKEN",
    "NEXT_PUBLIC_DASHBOARD_URL",
    "NEXT_PUBLIC_PLATFORM_DOMAIN",
    "PLATFORM_DOMAIN",
    "ALLOWED_API_ORIGINS",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "EMAIL_FROM",
    "EMAIL_DELIVERY_MODE",
    "EMAIL_REPLY_TO",
    "EMAIL_QA_DOMAIN_ROUTES",
    "MARKETING_INBOX_EMAILS",
    "RESEND_API_KEY",
    "TEST_EMAILS",
    "TEST_EMAIL",
    "TRIGGER_PROJECT_ID",
    "TRIGGER_PROFILE",
    "TRIGGER_SECRET_KEY",
    "STORE_CONVERSATION_ATTACHMENT_CAPABILITY_SECRET",
    "STORE_CONVERSATION_WHATSAPP_BRIDGE_SECRET",
    "STORE_CONVERSATION_NOTIFICATION_VERIFICATION_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_WEB_CLIENT_ID",
    "GOOGLE_ANDROID_CLIENT_ID",
    "GOOGLE_IOS_CLIENT_ID",
    "EXPO_PUBLIC_GOOGLE_CLIENT_ID",
    "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID",
    "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID",
    "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID",
    "EXPO_PUBLIC_CHAT_URL",
    "EXPO_PUBLIC_CHAT_PORT",
    "NEXT_PUBLIC_LOGLY_ENABLED",
    "NEXT_PUBLIC_LOGLY_PROJECT",
    "LOGLY_COLLECTOR_URL",
    "LOGLY_PROJECT_KEY",
    "LOGLY_MOBILE_PROJECT",
    "LOGLY_MOBILE_PROJECT_KEY",
    "EXPO_PUBLIC_LOGLY_ENABLED",
    "EXPO_PUBLIC_LOGLY_ENDPOINT"
  ]
}
