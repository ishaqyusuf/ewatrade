{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    ".env",
    ".env.development",
    ".env.local",
    ".env.development.local",
    ".env.remote-dev.local",
    ".env.remote-dev",
    ".env.production.local",
    ".env.production",
    "**/.env",
    "**/.env.development",
    "**/.env.local",
    "**/.env.development.local",
    "**/.env.remote-dev.local",
    "**/.env.remote-dev",
    "**/.env.production.local",
    "**/.env.production"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "API_URL",
        "NEXT_PUBLIC_API_URL",
        "STOREFRONT_URL",
        "NEXT_PUBLIC_STOREFRONT_URL",
        "NEXT_PUBLIC_APP_URL",
        "MOBILE_APP_URL",
        "NEXT_PUBLIC_MARKETING_URL",
        "NEXT_PUBLIC_DASHBOARD_URL",
        "NEXT_PUBLIC_PLATFORM_DOMAIN",
        "PLATFORM_DOMAIN",
        "ALLOWED_API_ORIGINS",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "EMAIL_FROM",
        "EMAIL_DELIVERY_MODE",
        "EMAIL_REPLY_TO",
        "EMAIL_QA_DOMAIN_ROUTES",
        "MARKETING_INBOX_EMAILS",
        "RESEND_API_KEY",
        "TEST_EMAILS",
        "TEST_EMAIL",
        "TRIGGER_PROJECT_ID",
        "TRIGGER_PROFILE",
        "TRIGGER_SECRET_KEY",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_WEB_CLIENT_ID",
        "GOOGLE_ANDROID_CLIENT_ID",
        "GOOGLE_IOS_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".expo/**",
        "dist/**",
        "generated/**",
        "build/**",
        "next-env.d.ts"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "outputs": ["generated/**"]
    }
  },
  "globalEnv": [
    "APP_ENV",
    "COMPOSE_FILE",
    "DATABASE_URL",
    "DB_SERVICE",
    "DB_WAIT_ATTEMPTS",
    "DB_WAIT_SECONDS",
    "DEV_PROFILE",
    "DOCKER_WAIT_ATTEMPTS",
    "DOCKER_WAIT_SECONDS",
    "REQUIRE_PROD_DATABASE_URL",
    "NODE_ENV",
    "TZ",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "API_URL",
    "NEXT_PUBLIC_API_URL",
    "STOREFRONT_URL",
    "NEXT_PUBLIC_STOREFRONT_URL",
    "NEXT_PUBLIC_APP_URL",
    "MOBILE_APP_URL",
    "NEXT_PUBLIC_MARKETING_URL",
    "NEXT_PUBLIC_DASHBOARD_URL",
    "NEXT_PUBLIC_PLATFORM_DOMAIN",
    "PLATFORM_DOMAIN",
    "ALLOWED_API_ORIGINS",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "EMAIL_FROM",
    "EMAIL_DELIVERY_MODE",
    "EMAIL_REPLY_TO",
    "EMAIL_QA_DOMAIN_ROUTES",
    "MARKETING_INBOX_EMAILS",
    "RESEND_API_KEY",
    "TEST_EMAILS",
    "TEST_EMAIL",
    "TRIGGER_PROJECT_ID",
    "TRIGGER_PROFILE",
    "TRIGGER_SECRET_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_WEB_CLIENT_ID",
    "GOOGLE_ANDROID_CLIENT_ID",
    "GOOGLE_IOS_CLIENT_ID",
    "EXPO_PUBLIC_GOOGLE_CLIENT_ID",
    "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID",
    "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID",
    "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID"
  ]
}
