# ── Database ──────────────────────────────────────────────────────────────────
# Put the appropriate complete URL in each mode-specific env file.
# .env.local owns the Neon development database; Docker is not a fallback.
EWATRADE_DATABASE_URL=postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Marketing Experience ──────────────────────────────────────────────────────
EWATRADE_MARKETING_EXPERIENCE=shop-v3
EWATARADE_MARKETING_EXPERIENCE_PREVIEW_TOKEN=

# ── Signup ────────────────────────────────────────────────────────────────────
# Set to "true" to show signup CTAs and enable /signup route.
# Keep false in production until launch-ready.
NEXT_PUBLIC_SIGNUP_ENABLED=false
# Early-access signup links are one-time onboarding sessions. Defaults to 7 days.
EARLY_ACCESS_LINK_TTL_DAYS=7

# ── Android Preview build publication ─────────────────────────────────────────
# Set these in the selected root profile (.env.preview for Preview publication).
# Configure the same private token plus APP_UPDATE_BACKEND on the API deployment.
# Generate a random token of at least 32 characters; never use EXPO_PUBLIC here.
APP_UPDATE_API_URL=
APP_UPDATE_PUBLISH_TOKEN=
APP_UPDATE_BACKEND=

# ── Runtime URLs ──────────────────────────────────────────────────────────────
API_URL=https://ewatrade-api.localhost
NEXT_PUBLIC_API_URL=https://ewatrade-api.localhost
STOREFRONT_URL=https://ewatrade-storefront.localhost
NEXT_PUBLIC_STOREFRONT_URL=https://ewatrade-storefront.localhost
CHAT_URL=https://chat.ewatrade-storefront.localhost
NEXT_PUBLIC_CHAT_URL=https://chat.ewatrade-storefront.localhost
# Comma-separated local device/emulator hosts allowed to load Next dev assets.
STOREFRONT_ALLOWED_DEV_ORIGINS=10.0.2.2,10.0.3.2
NEXT_PUBLIC_APP_URL=https://ewatrade.localhost
MOBILE_APP_URL=http://localhost:3096
NEXT_PUBLIC_MARKETING_URL=https://ewatrade.localhost
NEXT_PUBLIC_DASHBOARD_URL=https://ewatrade-dashboard.localhost
PLATFORM_DOMAIN=localhost
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost
ALLOWED_API_ORIGINS=https://chat.ewatrade-storefront.localhost,https://ewatrade-storefront.localhost,https://ewatrade.localhost,https://ewatrade-pos.localhost,https://ewatrade-dashboard.localhost,https://ewatrade-api.localhost
BETTER_AUTH_TRUSTED_ORIGINS=https://chat.ewatrade-storefront.localhost,https://ewatrade-storefront.localhost,https://ewatrade.localhost,https://ewatrade-pos.localhost,https://ewatrade-dashboard.localhost,https://ewatrade-api.localhost

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_FROM=noreply@ewatrade.local
EMAIL_REPLY_TO=team@ewatrade.local
MARKETING_INBOX_EMAILS=team@ewatrade.local
RESEND_API_KEY=
# External account-deletion requests are disabled until email delivery, an
# independent HMAC secret, and a proxy-overwritten client IP header are ready.
ACCOUNT_PRIVACY_REQUESTS_ENABLED=false
ACCOUNT_PRIVACY_PROCESSING_ENABLED=false
ACCOUNT_PRIVACY_MEMBERSHIP_PROCESSING_ENABLED=false
ACCOUNT_PRIVACY_SUBSCRIPTION_PROCESSING_ENABLED=false
ACCOUNT_PRIVACY_CONVERSATION_ACCESS_PROCESSING_ENABLED=false
ACCOUNT_PRIVACY_CONVERSATION_OUTCOME_PROCESSING_ENABLED=false
ACCOUNT_PRIVACY_IDENTITY_OUTCOME_PROCESSING_ENABLED=false
ACCOUNT_PRIVACY_COMPLETION_ENABLED=false
ACCOUNT_PRIVACY_NOTICE_WEBHOOK_ENABLED=false
ACCOUNT_PRIVACY_NOTICE_SENDING_ENABLED=false
ACCOUNT_PRIVACY_NOTICE_ALERTS_ENABLED=false
ACCOUNT_PRIVACY_NOTICE_ALERT_EMAILS=
ACCOUNT_PRIVACY_APPROVED_POLICY_VERSION=
ACCOUNT_PRIVACY_APPROVED_NOTICE_CONTENT_DIGEST=
ACCOUNT_PRIVACY_RESEND_WEBHOOK_SECRET=
# Independent 32+ byte secret; never reuse the Resend signing secret.
ACCOUNT_PRIVACY_NOTICE_RECIPIENT_HMAC_KEY=
ACCOUNT_PRIVACY_OTP_SECRET=
# Allowed: cf-connecting-ip or x-real-ip. The trusted proxy must overwrite it.
ACCOUNT_PRIVACY_TRUSTED_CLIENT_IP_HEADER=
# console outside production, live in production when omitted.
EMAIL_DELIVERY_MODE=console
# JSON map from reserved tester domains to their real inboxes.
# Example: {"example.qa.test":"tester@example.com"}
EMAIL_QA_DOMAIN_ROUTES=

# ── Development/Preview QA Accelerator (server-private) ──────────────────────
# Set APP_ENV to development or preview. Production startup rejects enablement.
QA_ACCELERATOR_ENABLED=false
# Authenticated, verified QA accounts may use draft tools in every environment.
# Production keeps credential bootstrap disabled, independently of this flag.
QA_TOOLS_ENABLED=true
# At least 32 random characters; never expose through NEXT_PUBLIC_/EXPO_PUBLIC_.
QA_ACCELERATOR_SECRET=
# Exact comma-separated website origins allowed to use the QA gate.
QA_ACCELERATOR_ALLOWED_ORIGINS=http://localhost:3092,http://localhost:3094
# Optional trusted-proxy rate-limit identity. Never use x-forwarded-for.
QA_ACCELERATOR_TRUSTED_CLIENT_IP_HEADER=
# Optional non-live SMS/WhatsApp receipt adapter for QA-classified tenants.
QA_MESSAGING_TEST_ADAPTER_ENABLED=false
# Legacy comma-separated recipients for exact @test.com email routing.
TEST_EMAILS=
# Legacy single-recipient fallback when TEST_EMAILS is empty.
TEST_EMAIL=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Server-side allowed audiences for Google ID token verification.
GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# Expo client IDs used to launch Google sign-in from the mobile app.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Server-only Sign in with Apple exchange and refresh-token custody.
APPLE_CLIENT_IDS=com.ewatrade.app
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=
APPLE_TOKEN_ENCRYPTION_KEY=

# Native store software subscriptions (off until provider and policy canaries pass).
STORE_BILLING_ENABLED=false
STORE_BILLING_PRODUCTION_CHECKOUT_ENABLED=false
STORE_BILLING_ENVIRONMENT=sandbox
STORE_SUBSCRIPTION_PRODUCTS=[]
APPLE_BUNDLE_ID=com.ewatrade.app
APPLE_APP_ID=6815837585
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
# Public Apple verification roots are fingerprint-pinned in the API bundle.
PLAY_PACKAGE_NAME=com.ewatrade.app
PLAY_NOTIFICATION_AUDIENCE=
PLAY_NOTIFICATION_SERVICE_EMAIL=
GOOGLE_APPLICATION_CREDENTIALS=
# Alternative serverless Play Publisher credential; store only as a sensitive API secret.
PLAY_PUBLISHER_SERVICE_ACCOUNT_JSON=
# Case custody remains off; even enabled intake returns 503 pending operations.
PLAY_REFUND_REVIEW_INTAKE_ENABLED=false
PLAY_REFUND_REVIEW_SUBMISSION_ENABLED=false
PLAY_REFUND_REVIEW_PRODUCTION_SUBMISSION_ENABLED=false
# Exact owner-approved response policy version; never infer from billing enablement.
PLAY_REFUND_REVIEW_RESPONSE_POLICY_VERSION=
# Internal operator queue summary; enable only with monitored recipients and live Resend.
PLAY_REFUND_REVIEW_ALERTS_ENABLED=false
PLAY_REFUND_REVIEW_ALERT_EMAILS=
# Enable only after the monitored alert canary; Pub/Sub then acknowledges persisted cases.
PLAY_REFUND_REVIEW_ACK_ENABLED=false
PLAY_REFUND_REVIEW_KEY_ID=
PLAY_REFUND_REVIEW_ENCRYPTION_KEY=
# JSON map of retired key IDs to base64 keys for decrypt-only custody; never include the active ID.
PLAY_REFUND_REVIEW_DECRYPTION_KEYS=

# ── Customer Messaging ────────────────────────────────────────────────────────
# Provider-neutral webhook endpoints. Each receives JSON containing
# intentId, message, and to, plus an optional Bearer token.
SERVICE_SMS_WEBHOOK_URL=
SERVICE_SMS_WEBHOOK_TOKEN=
SERVICE_WHATSAPP_WEBHOOK_URL=
SERVICE_WHATSAPP_WEBHOOK_TOKEN=
# HMAC key for one-minute, participant-bound Store Chat attachment uploads.
STORE_CONVERSATION_ATTACHMENT_CAPABILITY_SECRET=
# HMAC key for one-time, customer-sent Store Chat WhatsApp bridge codes.
STORE_CONVERSATION_WHATSAPP_BRIDGE_SECRET=
# HMAC key for digest-only Store Chat contact-verification codes.
STORE_CONVERSATION_NOTIFICATION_VERIFICATION_SECRET=

# ── WhatsApp & Sensitive Data ─────────────────────────────────────────────────
# One EwaTrade Meta app/webhook serves many pharmacy-owned WABAs. Sender
# credentials and phone_number_id values are encrypted per connection in DB.
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_STATE_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Base64-encoded 32-byte keys. Rotate only through an approved key migration.
COMMUNICATIONS_CREDENTIAL_ENCRYPTION_KEY=
PRESCRIPTION_DATA_ENCRYPTION_KEY=
# Explicit platform switch for regulated pharmacy activation in production.
# Keep false until licensing, PCN role, privacy/retention and provider approvals
# are reviewed and the pharmacy canary is authorized.
PRESCRIPTION_COMMERCE_LAUNCH_APPROVED=false
# Required in production for connection/customer/context-scoped conversation state.
REDIS_URL=

# ── Trigger.dev Jobs ──────────────────────────────────────────────────────────
TRIGGER_PROJECT_ID=
TRIGGER_PROFILE=ishaqyusuf
# Prefixed so one Vercel shared variable can serve every EwaTrade project.
# TRIGGER_SECRET_KEY is still accepted as a fallback. Production accepts
# tr_prod_sk_… and older tr_prod_… keys.
EWATRADE_TRIGGER_SECRET_KEY=

# ── Sentry Observability ──────────────────────────────────────────────────────
# Each deployed web/API/jobs project supplies its own values. Transmission and
# source-map upload remain disabled unless APP_ENV and NODE_ENV are production,
# and DSN plus release are present.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_APP_ENV=local
SENTRY_ORG=
SENTRY_PROJECT=
# Private build-time token used only for source-map and debug-symbol uploads.
SENTRY_AUTH_TOKEN=

# Mobile retains its dedicated cipron-concepts/ewatrade-mobile project.
EXPO_PUBLIC_SENTRY_DSN=https://1f5808d47a63fd6fc4daeb9f18763072@o4503970060238848.ingest.us.sentry.io/4511785763733504
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
EXPO_PUBLIC_SENTRY_ENABLED=false
EXPO_PUBLIC_SENTRY_RELEASE=

# ── Local Dev Ports ───────────────────────────────────────────────────────────
LEGACY_MOBILE_PORT=3002
STOREFRONT_PORT=3091
MARKETING_PORT=3092
POS_PORT=3093
DASHBOARD_PORT=3094
API_PORT=3095
MOBILE_PORT=3096
EXPO_PORT=3096
EMAIL_PORT=3003

# ── Live QA ───────────────────────────────────────────────────────────────────
# Optional guarded live Google OAuth QA.
# This verifies a fresh Google ID token through the deployed API and may create
# or update account/session records, so keep confirmation blank unless approved.
# The evidence path is required so the run leaves a value-safe JSON proof file.
GOOGLE_LIVE_CONFIRM_AUTH=
GOOGLE_LIVE_ID_TOKEN=
GOOGLE_LIVE_MODE=
GOOGLE_LIVE_EXPECTED_EMAIL=
GOOGLE_LIVE_EVIDENCE_PATH=
GOOGLE_LIVE_NAME=
GOOGLE_LIVE_BUSINESS_NAME=
GOOGLE_LIVE_ALLOW_LOCALHOST=
# Set the confirmations only for an intentional live shared-link QA run that may
# create product links, customer order requests, notification audit rows, and
# follow-up records against the selected API/storefront/database target.
# The evidence path is required so the run leaves a value-safe JSON proof file.
SHARED_LINK_LIVE_CONFIRM_WRITES=
SHARED_LINK_LIVE_CONFIRM_EMAIL_DELIVERY=
SHARED_LINK_LIVE_OWNER_BEARER_TOKEN=
SHARED_LINK_LIVE_PRODUCT_ID=
SHARED_LINK_LIVE_CUSTOMER_EMAIL=
SHARED_LINK_LIVE_CUSTOMER_NAME=
SHARED_LINK_LIVE_CUSTOMER_PASSWORD=
SHARED_LINK_LIVE_FOLLOW_UP_MODE=
SHARED_LINK_LIVE_EVIDENCE_PATH=
# Optional. Defaults to 1 when blank.
SHARED_LINK_LIVE_QUANTITY=
SHARED_LINK_LIVE_ALLOW_LOCALHOST=
# Optional non-mutating public preview check for an existing deployed share URL.
# Use this before release to verify canonical, Open Graph, Twitter, and OG image
# responses from the exact URL that will be pasted into WhatsApp or similar apps.
SHARED_LINK_PREVIEW_URL=
SHARED_LINK_PREVIEW_EXPECTED_HOST=
SHARED_LINK_PREVIEW_EXPECTED_PRODUCT_NAME=
SHARED_LINK_PREVIEW_EXPECTED_BUSINESS_NAME=
SHARED_LINK_PREVIEW_EVIDENCE_PATH=
SHARED_LINK_PREVIEW_ALLOW_LOCALHOST=
# Optional guarded browser checkout smoke for an existing deployed share URL.
# This submits a disposable customer order request, so keep the confirmation
# blank unless the selected product link is approved for browser checkout QA.
# The screenshot path is required so the run leaves durable browser evidence.
SHARED_LINK_BROWSER_CONFIRM_ORDER=
SHARED_LINK_BROWSER_CUSTOMER_EMAIL=
SHARED_LINK_BROWSER_CUSTOMER_NAME=
SHARED_LINK_BROWSER_CUSTOMER_PASSWORD=
SHARED_LINK_BROWSER_AUTH_MODE=
# Optional. Defaults to 1 when blank.
SHARED_LINK_BROWSER_QUANTITY=
SHARED_LINK_BROWSER_CUSTOMER_PHONE=
SHARED_LINK_BROWSER_NOTES=
SHARED_LINK_BROWSER_SCREENSHOT_PATH=
SHARED_LINK_BROWSER_HEADFUL=
SHARED_LINK_BROWSER_ALLOW_LOCALHOST=

# ── Vercel API Deployment ─────────────────────────────────────────────────────
# Required to attach verified storefront domains and provision free tenant
# subdomains. Keep the token server-side and scoped to the owning team.
VERCEL_API_TOKEN=
VERCEL_API_PROJECT_ID=
VERCEL_API_ORG_ID=
# Database preparation uses the existing local-infra-kit db:push workflow.
# release:run pushes locally then to the selected environment before app work.
# Production API deployment itself never runs database mutations.

# ── Vercel Domain Management ──────────────────────────────────────────────────
VERCEL_TEAM_ID=
VERCEL_STOREFRONT_PROJECT_ID=
VERCEL_POS_PROJECT_ID=
VERCEL_DASHBOARD_PROJECT_ID=

# ── Customer Chat App Links ──────────────────────────────────────────────────
# Set on the deployed chat.ewatrade.com Storefront after verifying its host.
# The well-known routes fail closed until signing identifiers are supplied.
# Production Apple Team ID and bundle ID were verified in the Apple portal.
EWATRADE_APPLE_APP_SITE_ASSOCIATION_APP_IDS=ZXC78SPCV4.com.ewatrade.app
EWATRADE_ANDROID_APP_LINK_PACKAGE_NAMES=com.ewatrade.app
# Use the Google Play app-signing SHA-256 certificate, not the EAS upload key.
EWATRADE_ANDROID_APP_LINK_CERTIFICATE_SHA256=

# ── Managed Domain Purchasing ─────────────────────────────────────────────────
# GO54 is the primary registrar for .com.ng.
GO54_API_USERNAME=
GO54_API_KEY=
# Optional override for a compatible staging proxy.
GO54_API_BASE_URL=
# Openprovider is the registrar for global .com purchases.
OPENPROVIDER_API_USERNAME=
OPENPROVIDER_API_PASSWORD=
# Optional override for a future working sandbox or controlled proxy.
OPENPROVIDER_API_BASE_URL=
# 32+ random bytes recommended. Changing this key without a rotation process
# makes saved registrant profiles unreadable.
DOMAIN_DATA_ENCRYPTION_KEY=
# Retail formula: converted wholesale + basis-point markup + fixed minor-unit fee.
DOMAIN_PRICE_MARKUP_BPS=2000
DOMAIN_FIXED_FEE_MINOR=100000
# Required while Openprovider returns USD wholesale prices.
DOMAIN_USD_NGN_RATE=
# Add the matching <CURRENCY> rate if the Openprovider reseller account bills
# in another currency, for example DOMAIN_EUR_NGN_RATE.
DOMAIN_EUR_NGN_RATE=
# Defaults to Vercel DNS when blank.
DOMAIN_MANAGED_NAMESERVERS=ns1.vercel-dns.com,ns2.vercel-dns.com
DOMAIN_DASHBOARD_CALLBACK_URL=https://ewatrade-dashboard.localhost/settings/domains
DOMAIN_MOBILE_CALLBACK_URL=ewatrade://domain-management-modal

# ── Payments ──────────────────────────────────────────────────────────────────
# Hosted checkout and signed webhook verification.
PAYSTACK_SECRET_KEY=

# Catalog private photos: server/jobs only; choose and pin the store per profile.
# Vercel credential must match BLOB_STORE_ID. Never expose to clients.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Explicit rollout gate; keep off until provider configuration is verified.
CATALOG_PHOTO_CLEANUP_ENABLED=false
# Catalog image moderation: API/jobs only. Dedicated key wins; OPENAI_API_KEY
# is the fallback. Keep off until the selected environment is configured.
CATALOG_PHOTO_REVIEW_ENABLED=false
CATALOG_PHOTO_REVIEW_OPENAI_API_KEY=
OPENAI_API_KEY=

# ── Product category suggestions (server only) ───────────────────────────────
# Database config controls enablement/provider/model; never expose these to mobile.
# A blank dedicated key uses the general provider key.
CATEGORY_SUGGESTION_DEEPSEEK_API=
DEEPSEEK_API=
CATEGORY_SUGGESTION_OPENAI_API=
OPENAI_API=
# OPENAI_API_KEY is also accepted as the final OpenAI fallback.

# ── AI setup assistant (API server only) ────────────────────────────────────
# Default off. SystemConfiguration "assistant.runtime" wins over the provider/
# model pair below; default is DEEPSEEK/deepseek-flash. Dedicated keys win;
# DEEPSEEK_API / OPENAI_API_KEY / OPENAI_API are fallbacks. QA tenants always use
# the provider-free rehearsal model. ASSISTANT_REHEARSAL_MODE forces it outside
# production for local UI work without provider spend.
ASSISTANT_SETUP_ENABLED=false
ASSISTANT_AI_PROVIDER=
ASSISTANT_AI_MODEL=
ASSISTANT_DEEPSEEK_API_KEY=
ASSISTANT_OPENAI_API_KEY=
ASSISTANT_REHEARSAL_MODE=false

# General assistant launch stays off until runtime/device/rollout review completes.
ASSISTANT_GENERAL_ENABLED=false
# Separate random server key, at least 32 characters; never expose to clients.
ASSISTANT_APPROVAL_SIGNING_KEY=
