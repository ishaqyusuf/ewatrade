# Preview overrides loaded over .env.local.

# ── Database ──────────────────────────────────────────────────────────────────
EWATRADE_DATABASE_URL=

# ── QA Accelerator ────────────────────────────────────────────────────────────
# Keep these server-private. Use custom preview hosts under PLATFORM_DOMAIN so
# ordinary cross-subdomain auth cookies remain valid after profile selection.
APP_ENV=preview
QA_ACCELERATOR_ENABLED=true
QA_ACCELERATOR_SECRET=
QA_ACCELERATOR_ALLOWED_ORIGINS=
# Optional: only when a trusted proxy overwrites this header.
# Allowed: cf-connecting-ip, x-real-ip.
QA_ACCELERATOR_TRUSTED_CLIENT_IP_HEADER=
QA_MESSAGING_TEST_ADAPTER_ENABLED=false
EMAIL_QA_DOMAIN_ROUTES=

# ── Store Conversation Security ──────────────────────────────────────────────
STORE_CONVERSATION_ATTACHMENT_CAPABILITY_SECRET=
# One-time, customer-sent Store Chat WhatsApp bridge-code HMAC key.
STORE_CONVERSATION_WHATSAPP_BRIDGE_SECRET=
STORE_CONVERSATION_NOTIFICATION_VERIFICATION_SECRET=

# ── Marketing Experience ──────────────────────────────────────────────────────
EWATRADE_MARKETING_EXPERIENCE=operator-v2
EWATARADE_MARKETING_EXPERIENCE_PREVIEW_TOKEN=
