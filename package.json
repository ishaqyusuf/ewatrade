{
  "name": "ewatrade",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "catalog": {
    "next": "^16.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "4.1.18",
    "@tailwindcss/postcss": "4.1.18",
    "typescript": "^5.9.3",
    "zod": "^4.1.5"
  },
  "overrides": {
    "@react-pdf/font": "4.0.4",
    "expo-constants": "18.0.14",
    "fast-uri": "3.1.7",
    "hono": "4.13.9",
    "lightningcss": "1.30.1",
    "socket.io-client": "4.8.4",
    "tar": "7.5.21"
  },
  "workspaces": ["apps/*", "packages/*", "tooling/*"],
  "scripts": {
    "db:seed:category-suggestion-config": "node ./scripts/with-workspace-env.mjs bun run --cwd packages/db seed:category-suggestion-config",
    "build": "turbo build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "db:generate": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts generate --profile ewatrade",
    "db:format": "node ./scripts/with-workspace-env.mjs bun run --cwd packages/db db:format",
    "db:drift-inventory": "node ./scripts/with-workspace-env.mjs APP_ENV=production DEV_PROFILE=prod REQUIRE_PROD_DATABASE_URL=1 bun packages/db/scripts/service-commerce-production-drift-inventory.ts",
    "db:migrate": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts migrate --profile ewatrade",
    "db:pull": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts pull --profile ewatrade",
    "db:push": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts push --profile ewatrade",
    "db:seed:catalog-units": "node ./scripts/with-workspace-env.mjs bun run --cwd packages/db seed:catalog-units",
    "db:studio": "bun --env-file=/dev/null ../local-infra-kit/bin/db.ts studio --profile ewatrade",
    "db:sync": "bun --env-file=/dev/null ../local-infra-kit/bin/db-sync.ts --profile ewatrade",
    "kill:ports": "bun --env-file=/dev/null ../local-infra-kit/bin/kill-ports.ts --profile ewatrade",
    "killports": "bun run kill:ports",
    "dev:prepare": "bun run kill:ports && bun run dev:services",
    "dev": "bun scripts/dev.ts",
    "dev:services": "node ./scripts/with-workspace-env.mjs bun --env-file=/dev/null ../local-infra-kit/bin/dev-services.ts --profile ewatrade",
    "dev:storefront": "bun run dev --filter storefront",
    "dev:marketing": "bun run dev --filter marketing",
    "dev:pos": "bun run dev --filter pos",
    "dev:dashboard": "bun run dev --filter dashboard",
    "dev:api": "bun run dev --filter api",
    "eas:auth": "bun --env-file=/dev/null ./scripts/eas-account-runner.ts auth",
    "eas:build": "bun --env-file=/dev/null ./scripts/eas-account-runner.ts build",
    "eas:submit": "bun --env-file=/dev/null ./scripts/eas-account-runner.ts submit",
    "eas:view": "bun --env-file=/dev/null ./scripts/eas-account-runner.ts view",
    "eas:download": "bun --env-file=/dev/null ./scripts/eas-account-runner.ts download",
    "eas:update": "bun --env-file=/dev/null ./scripts/eas-account-runner.ts update",
    "eas:update:prepare": "node ./apps/mobile/scripts/eas-update.mjs --prepare-only",
    "eas:env:sync": "bun --env-file=/dev/null ./scripts/eas-account-runner.ts env-sync",
    "eas:env:chat-sync": "bun --env-file=/dev/null ./scripts/eas-account-runner.ts env-chat-sync",
    "eas:env:legal-sync": "bun --env-file=/dev/null ./scripts/eas-account-runner.ts env-legal-sync",
    "eas:env:analytics-sync": "bun --env-file=/dev/null ./scripts/eas-account-runner.ts env-analytics-sync",
    "eas:env:check": "bun --env-file=/dev/null ./scripts/eas-account-runner.ts env-check",
    "api:deploy": "node scripts/deploy-api.mjs",
    "api:preview:preflight": "node scripts/check-api-preview-readiness.mjs",
    "api:preview:deploy": "node scripts/deploy-api-preview.mjs",
    "qa:preview-auth-smoke": "node scripts/with-workspace-env.mjs APP_ENV=preview DEV_PROFILE=preview NODE_ENV=development bun --env-file=/dev/null scripts/qa-preview-auth-smoke.ts",
    "qa:preview-mobile-otp-smoke": "node scripts/with-workspace-env.mjs APP_ENV=preview DEV_PROFILE=preview NODE_ENV=development bun --env-file=/dev/null scripts/qa-preview-mobile-otp-smoke.ts",
    "deploy:api": "bun run api:deploy",
    "email:dev": "bun --filter @ewatrade/email dev",
    "email:test": "node ./scripts/with-workspace-env.mjs bun scripts/send-test-email.mjs",
    "jobs:deploy": "bun --filter @ewatrade/jobs deploy",
    "jobs:preview:deploy": "bun --filter @ewatrade/jobs deploy:preview",
    "app:update": "bun --env-file=/dev/null ../local-infra-kit/bin/app-update.ts",
    "test:app-update-client": "bun --env-file=/dev/null scripts/test-app-update-client.ts",
    "release": "bun --env-file=/dev/null ../local-infra-kit/bin/infra.ts release",
    "lint": "turbo lint",
    "qa:accelerator:artifact": "node scripts/check-qa-accelerator-artifact.mjs",
    "qa:production-legal-live": "bun scripts/check-production-legal-live.mjs",
    "qa:production-android-app-links": "node scripts/check-production-android-app-links.mjs",
    "qa:production-ios-universal-links": "node scripts/check-production-ios-universal-links.mjs",
    "qa:production-api-host": "node scripts/check-production-api-host.mjs",
    "qa:ios-login-config": "node scripts/with-workspace-env.mjs APP_ENV=production DEV_PROFILE=prod node scripts/check-ios-login-readiness.mjs",
    "qa:store-billing-config": "node scripts/with-workspace-env.mjs APP_ENV=production DEV_PROFILE=prod node scripts/check-store-billing-readiness.mjs",
    "qa:legal-acceptance-audit": "node scripts/with-workspace-env.mjs bun scripts/audit-legal-acceptance.ts",
    "qa:tar-override": "node --test scripts/giget-tar-override.test.mjs",
    "mobile:android:connect": "node apps/mobile/scripts/prepare-android-dev.mjs",
    "mobile:android:open": "node apps/mobile/scripts/open-android-app-url.mjs",
    "typecheck": "turbo typecheck",
    "format": "biome format --write .",
    "db:start": "bun run dev:services",
    "qa:native-onboarding-continuation": "node scripts/with-workspace-env.mjs DEV_PROFILE=local APP_ENV=local NODE_ENV=development bun --env-file=/dev/null scripts/qa-native-onboarding-continuation.ts"
  },
  "dependencies": {
    "@biomejs/biome": "^1.9.4",
    "hono": "4.13.9",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "patchedDependencies": {
    "react-native-css@3.0.1": "patches/react-native-css@3.0.1.patch"
  }
}
