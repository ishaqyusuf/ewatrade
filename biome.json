{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "files": {
    "ignore": [
      "node_modules",
      ".next",
      ".turbo",
      "dist",
      "build",
      "**/next-env.d.ts"
    ]
  },
  "overrides": [
    {
      "include": [
        "packages/storefront-templates/src/generated/**/component.tsx"
      ],
      "organizeImports": { "enabled": false }
    },
    {
      "include": [
        "packages/storefront-templates/src/generated/**/manifest.json",
        "packages/storefront-templates/src/generated/**/styles.css"
      ],
      "formatter": { "enabled": false }
    }
  ]
}
