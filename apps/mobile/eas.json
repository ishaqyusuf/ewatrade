{
  "cli": {
    "version": ">= 16.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "bun": "1.3.9",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "bun": "1.3.9",
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_SENTRY_ENABLED": "false",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "autoIncrement": true,
      "channel": "preview"
    },
    "production": {
      "bun": "1.3.9",
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_SENTRY_ENABLED": "false",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "environment": "production",
      "channel": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "testflight-production": {
      "extends": "production",
      "distribution": "store",
      "channel": "testflight-production",
      "environment": "production",
      "credentialsSource": "local",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_APP_VARIANT": "production",
        "IOS_TESTFLIGHT": "1",
        "EXPO_PUBLIC_API_URL": "https://api.ewatrade.com",
        "EXPO_PUBLIC_DASHBOARD_URL": "https://dash.ewatrade.com",
        "EXPO_PUBLIC_BASE_URL": "https://dash.ewatrade.com",
        "EXPO_PUBLIC_WEB_URL": "https://dash.ewatrade.com",
        "EXPO_PUBLIC_CHAT_URL": "https://chat.ewatrade.com",
        "EXPO_PUBLIC_LEGAL_ORIGIN": "https://ewatrade.com"
      },
      "ios": {
        "simulator": false
      }
    },
    "testflight-preview": {
      "extends": "preview",
      "distribution": "store",
      "channel": "testflight-preview",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_APP_VARIANT": "preview",
        "IOS_TESTFLIGHT": "1",
        "EXPO_PUBLIC_DASHBOARD_URL": "https://preview-dashboard.ewatrade.com",
        "EXPO_PUBLIC_BASE_URL": "https://preview-dashboard.ewatrade.com",
        "EXPO_PUBLIC_WEB_URL": "https://preview-dashboard.ewatrade.com",
        "EXPO_PUBLIC_LEGAL_ORIGIN": "https://ewatrade.com"
      },
      "ios": {
        "simulator": false
      },
      "environment": "preview",
      "credentialsSource": "local"
    },
    "play-preview": {
      "extends": "preview",
      "distribution": "store",
      "environment": "preview",
      "channel": "play-preview",
      "credentialsSource": "local",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_APP_VARIANT": "preview",
        "APP_ENV": "preview",
        "DEV_PROFILE": "preview",
        "ANDROID_PLAY_TEST": "1",
        "EXPO_PUBLIC_API_URL": "https://preview-api.ewatrade.com",
        "EXPO_PUBLIC_DASHBOARD_URL": "https://preview-dashboard.ewatrade.com",
        "EXPO_PUBLIC_BASE_URL": "https://preview-dashboard.ewatrade.com",
        "EXPO_PUBLIC_WEB_URL": "https://preview-dashboard.ewatrade.com",
        "EXPO_PUBLIC_CHAT_URL": "https://preview-storefront.ewatrade.com",
        "EXPO_PUBLIC_CUSTOMER_CHAT_HOST": "preview-storefront.ewatrade.com",
        "EXPO_PUBLIC_LEGAL_ORIGIN": "https://ewatrade.com",
        "EXPO_PUBLIC_AUTO_UPDATE_ON_FOREGROUND": "false"
      }
    }
  },
  "submit": {
    "testflight-production": {
      "ios": {
        "ascAppId": "6815837585",
        "appleTeamId": "ZXC78SPCV4",
        "bundleIdentifier": "com.ewatrade.app"
      }
    },
    "production": {
      "android": {
        "track": "internal"
      }
    },
    "testflight-preview": {
      "ios": {
        "ascAppId": "6815837585",
        "appleTeamId": "ZXC78SPCV4",
        "bundleIdentifier": "com.ewatrade.app"
      }
    }
  }
}
